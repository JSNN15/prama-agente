# prama-agent — LLM providers
# Copy to /etc/prama-agent/providers.env or ~/.config/prama-agent/providers.env (chmod 600).
# Keys are exported only inside the agent pane, never on a command line.

# ── OpenRouter: one key for hundreds of models, including free ones (":free") ─
# Used directly by opencode:   prama-agent opencode backend --model openrouter/moonshotai/kimi-k2
# and by Claude Code through OpenRouter's Anthropic-compatible endpoint:
#                              prama-agent claude backend --profile openrouter --model <id>
# Free tier: 20 req/min; 50 req/day (1000/day after buying $10 of credits once).
OPENROUTER_API_KEY=""
# OPENROUTER_ANTHROPIC_URL="https://openrouter.ai/api"
# OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"   # default model for --profile openrouter

# ── Other keys opencode picks up natively (optional) ────────────────────────
# DEEPSEEK_API_KEY=""  ZHIPU_API_KEY=""  GROQ_API_KEY=""  DEEPINFRA_API_KEY=""  CEREBRAS_API_KEY=""

# ── Claude Code against other Anthropic-compatible endpoints (--profile) ─────
# DeepSeek:   prama-agent claude backend --profile deepseek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/anthropic"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_FAST_MODEL="deepseek-chat"

# Z.ai / Zhipu GLM Coding Plan:   prama-agent claude backend --profile glm
GLM_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/anthropic"
GLM_MODEL="glm-4.6"

# Local proxy (claude-code-router, LiteLLM, vLLM…):   --profile local
LOCAL_ROUTER_URL="http://127.0.0.1:3456"
LOCAL_ROUTER_TOKEN="local-router"
LOCAL_ROUTER_MODEL="default"
