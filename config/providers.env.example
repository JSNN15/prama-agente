# prama-agent — Multi-Provider LLM Routing Profiles
# Copy to /etc/prama-agent/providers.env or ~/.config/prama-agent/providers.env (chmod 600)
#
# Usage:
#   prama-agent claude backend --profile kimi
#   prama-agent claude backend --profile openrouter-free
#   prama-agent claude backend --profile deepseek
#   prama-agent claude backend --profile glm

# ── 1. Moonshot AI (Kimi Coding / K3) ───────────────────────────────────────
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.ai/anthropic"
KIMI_MODEL="kimi-k2.7"

# ── 2. DeepSeek (Anthropic-Compatible Gateway) ──────────────────────────────
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/anthropic"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_FAST_MODEL="deepseek-chat"

# ── 3. Z.ai / Zhipu GLM Coding Plan ─────────────────────────────────────────
GLM_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/anthropic"
GLM_MODEL="glm-4.6"

# ── 4. OpenRouter (Paid or :free Tier) ──────────────────────────────────────
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_FREE_MODEL="qwen/qwen3-coder:free"
OPENROUTER_MAIN_MODEL="anthropic/claude-sonnet-4"

# ── 5. Local / Custom Proxy (e.g. claude-code-router / LiteLLM / vLLM) ──────
LOCAL_ROUTER_URL="http://127.0.0.1:3456"
LOCAL_ROUTER_TOKEN="local-router"
LOCAL_ROUTER_MODEL="default"
