# prama-agent — configuration (bash syntax, loaded at startup)
# Locations: /etc/prama-agent/config.env (system) and ~/.config/prama-agent/config.env (user, wins)
# This file is executed as bash: keep it owned by you / root and not writable by others.

# ── Workspaces (zones) ──────────────────────────────────────────────────────
# Leave ZONES commented to auto-discover every git repo directly under PRAMA_DISCOVER_ROOTS.
# ZONES=(backend frontend infra)
# ZONE_DIRS=(/srv/app-backend /srv/app-frontend /srv/infra)
# ZONE_DESCS=("core backend service" "web application" "infrastructure")
PRAMA_DISCOVER_ROOTS="/opt $HOME"

# ── Agents ──────────────────────────────────────────────────────────────────
# Supported: claude (Claude Code), agy (Antigravity CLI), opencode (OpenRouter & open models)
# AGENTS=(claude agy opencode)
# Default model for opencode (provider/model; ":free" = OpenRouter free tier)
# PRAMA_OPENCODE_MODEL="openrouter/qwen/qwen3-coder:free"

# ── Safety defaults ─────────────────────────────────────────────────────────
# Permission mode for new agents: 0 = ask (agent asks before each action, recommended)
#                                 1 = yolo (no confirmations; only on isolated servers)
PRAMA_SKIP_PERMISSIONS=0

# Native Remote Control (claude --remote-control / agy --remote-control) by default
PRAMA_DEFAULT_REMOTE=0

# Default role: executor | coordinator | reader | daemon
PRAMA_DEFAULT_ROLE="executor"

# ── Fleet (coordinator powers & health) ─────────────────────────────────────
# Max live agent sessions; `fleet spawn` refuses beyond it
PRAMA_FLEET_MAX=8
# What an agent (e.g. a coordinator) may manage with `prama-agent fleet`:
#   zone = agents of its own zone (default) · children = only agents it spawned · all
# Agents can never act on themselves or on a coordinator.
PRAMA_FLEET_SCOPE="zone"
# State hooks (login/quota/model errors → BLOCKED, model and conversation id).
# claude: per session via --settings. agy: one named entry "prama-agent" in
# ~/.gemini/config/hooks.json (agy has no per-session hooks); remove it with `fleet hooks uninstall`.
PRAMA_HOOKS=1
# Status line telemetry: quota used (5h / 7d windows) and context %, from claude's and agy's
# status line. Alerts coordinators once per account and window above PRAMA_QUOTA_WARN %.
PRAMA_STATUSLINE=1
# PRAMA_QUOTA_WARN=90
# Fleet watchdog: alerts coordinators/Telegram about blocked or stopped agents and delivers
# queued tasks when an agent becomes ready. Starts automatically with the first agent.
PRAMA_WATCHDOG=1
PRAMA_WATCH_INTERVAL=5
# Seconds after which a transient block (quota, overload) is considered stale
# PRAMA_BLOCK_TTL=900

# ── Sessions & UI ───────────────────────────────────────────────────────────
PRAMA_SESSION_PREFIX="prama"
# Key that detaches from an agent back to the menu (tmux key syntax). Avoid C-g: Claude Code uses it.
PRAMA_MENU_KEY="M-m"
# Dedicated tmux server name (tmux -L <name>). prama never touches your own tmux server.
PRAMA_TMUX_SOCKET="prama"

# ── Worktrees ───────────────────────────────────────────────────────────────
# Files copied from the repo into each new worktree (chmod 600)
PRAMA_WORKTREE_COPY_FILES=".env .env.local .mcp.json"
# Where worktrees are created (default: <repo parent>/.prama-worktrees/<repo>/<branch>)
# PRAMA_WORKTREE_ROOT="/srv/worktrees"
