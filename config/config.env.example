# prama-agent — Workspace, Role & Agent Configuration
# Copy this file to /etc/prama-agent/config.env or ~/.config/prama-agent/config.env

# ── Registered CLI Agents ───────────────────────────────────────────────────
AGENTS=(claude agy kimi gemini qwen)
AGENT_DESCS=(
  "Claude Code (Anthropic / Custom API)"
  "Agy (Antigravity CLI)"
  "Kimi Code (Moonshot AI CLI)"
  "Gemini CLI (Google AI)"
  "Qwen Code (Alibaba / OpenRouter)"
)

# ── Registered Workspaces (Zones) ───────────────────────────────────────────
ZONES=(backend frontend infra)
ZONE_DIRS=(/srv/app-backend /srv/app-frontend /srv/infra)
ZONE_DESCS=(
  "core backend service"
  "web application"
  "infrastructure & monitoring"
)

# ── Session, Role & Permission Defaults ─────────────────────────────────────
PRAMA_SESSION_PREFIX="prama"
PRAMA_WORKTREE_COPY_FILES=".env .env.local .mcp.json"

# Default permission-bypass (YOLO) in sandboxed server environments (1 = enabled, 0 = ask)
PRAMA_SKIP_PERMISSIONS=1

# Enable native Remote Control (--remote-control) by default on startup (1 = on, 0 = off)
PRAMA_DEFAULT_REMOTE=1

# Default agent role (executor | coordinator | reader | daemon)
PRAMA_DEFAULT_ROLE="executor"
