#!/usr/bin/env bash
# prama-claude — Shortcut: 'prama-claude <zona> [opciones]' equals 'prama-agent claude <zona> [opciones]'
# Licensed under the Apache License, Version 2.0
set -u
MAIN="$(dirname "$(readlink -f "$0")")/prama-agent"
case "${1:-}" in
  status|ls|ps|sessions|attach|a|stop|kill|restart|logs|capture|send|worktree|wt|profiles|mcp|doctor|info|bus|cockpit|fzf|telegram|-h|--help|-v|--version)
    exec "$MAIN" "$@" ;;
esac
exec "$MAIN" claude "$@"
