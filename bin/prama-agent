#!/usr/bin/env bash
# prama-agent — Multi-agent terminal control plane for CLI coding agents
# Copyright 2026 Julian Neira Nova
# Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0)

set -u

VERSION="6.5.0"

# Status line fast path: agy redraws it several times per second, so the last line is reused
# for PRAMA_SL_MIN seconds with bash builtins only (no forks, before anything else runs).
if [ "${1:-}" = "--internal-statusline" ] && [ -n "${PRAMA_SL_CACHE:-}" ] \
   && { IFS= read -r _ts && IFS= read -r _line; } < "$PRAMA_SL_CACHE" 2>/dev/null \
   && [[ "$_ts" =~ ^[0-9]+$ ]] && printf -v _now '%(%s)T' -1 && (( _now - _ts < ${PRAMA_SL_MIN:-10} )); then
  read -r -d '' _ || true
  printf '%s\n' "$_line"
  exit 0
fi
# Hooks fired outside prama panes (agy's hooks are global): answer "no decision" and leave.
if [ "${1:-}" = "--internal-hook" ] && [ -z "${PRAMA_SESSION:-}" ]; then
  [ "${2:-}" = agy ] && printf '{}\n'
  read -r -d '' _ || true
  exit 0
fi

SELF_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
REPO_ROOT="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
LIB_DIR="$REPO_ROOT/lib"
export SELF_PATH LIB_DIR VERSION

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  # The catalogs need bash 4 (associative arrays): this one message picks its language by hand.
  case ${PRAMA_LANG:-}:${LC_ALL:-${LC_MESSAGES:-${LANG:-}}} in
    es:*|auto:es*|:es*) echo "prama-agent requiere bash >= 4.4 (tienes $BASH_VERSION)" >&2 ;;
    *)                  echo "prama-agent requires bash >= 4.4 (this is $BASH_VERSION)" >&2 ;;
  esac
  exit 1
fi

case "${1:-}" in
  -v|--version|version) printf 'prama-agent v%s\n' "$VERSION"; exit 0 ;;
esac

for _p in "$HOME/.local/bin" "$HOME/.opencode/bin" "/usr/local/bin"; do
  [ -d "$_p" ] && [[ ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
export PATH

case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
  *[Uu][Tt][Ff]*8*) ;;
  *) export LC_ALL=C.UTF-8 ;;
esac

# Hook fast path: called by the agent CLI on every lifecycle event; must be quick and silent.
# agy expects a JSON object on stdout ("{}" = no decision).
if [ "${1:-}" = "--internal-hook" ]; then
  [ "${2:-}" = agy ] && printf '{}\n'
  # shellcheck source=/dev/null
  # PRAMA_HOOK_DEBUG=<file> collects errors while diagnosing a CLI's hook integration.
  { source "$LIB_DIR/core.sh" && source "$LIB_DIR/health.sh" && prama_init && hook_ingest "${2:-}" "${3:-}"; } \
    >/dev/null 2>>"${PRAMA_HOOK_DEBUG:-/dev/null}"
  exit 0
fi

# Status line (cache miss): parse the payload, update the quota file, print the line.
if [ "${1:-}" = "--internal-statusline" ]; then
  # shellcheck source=/dev/null
  { source "$LIB_DIR/core.sh" && source "$LIB_DIR/health.sh" && prama_init >/dev/null && statusline_ingest "${2:-}"; } \
    2>>"${PRAMA_HOOK_DEBUG:-/dev/null}"
  exit 0
fi

for _m in core ui agents roles bus swarm worktrees health fleet feedback memory setup prefs telegram tui; do
  # shellcheck source=/dev/null
  source "$LIB_DIR/$_m.sh"
done

prama_init
command -v tmux >/dev/null 2>&1 || die "$(_t 'tmux is not installed (sudo apt install tmux).')"

# ── Small helpers ───────────────────────────────────────────────────────────
pause_key() {
  (( IS_TTY )) || return 0
  printf '\n %s%s %s %s' "$KEY_BADGE" " ↵ " "$(_t 'Press any key to go back')" "$C_OFF"
  IFS= read -rsn1 _ || true
}

# Resolves an exact (or unique-prefix) match from a list; prints it or returns 1.
match_one() {
  local needle=$1; shift
  local e hits=()
  is_in "$needle" "$@" && { printf '%s' "$needle"; return 0; }
  for e in "$@"; do [[ "$e" == "$needle"* ]] && hits+=("$e"); done
  (( ${#hits[@]} == 1 )) && { printf '%s' "${hits[0]}"; return 0; }
  return 1
}

require_session() {
  local s=${1:-}
  [ -n "$s" ] || die "$(_t 'Missing the session name. See the active ones with: prama-agent status')"
  tmx_has "$s" || die "$(_t "Session '%s' does not exist on the prama server. Active: %s" "$s" "$(prama_sessions | tr '\n' ' ')")"
}

# ── Subcommands ─────────────────────────────────────────────────────────────
usage() {
  local perm=ask
  (( PRAMA_SKIP_PERMISSIONS )) && perm=yolo
  case $PRAMA_UI_LANG in
    es) _usage_es "$perm" ;;
    *)  _usage_en "$perm" ;;
  esac
}

# _usage_<lang> <default permission mode> — the help screen, one text per language.
_usage_en() {
  cat <<EOF
${C_BOLD}prama-agent v$VERSION${C_OFF} — control plane for terminal coding agents

${C_BOLD}FIRST STEPS${C_OFF}
  setup                  Wizard: agents and login, zones, permissions (re-runnable; --check only checks)
  login [agent]          Login status of each agent / sign in (claude, agy)
  zones [add <name> <dir> | remove <name> | scan]   Work folders under a short name
  lang [en|es|auto]      Interface language       theme [name]  Color theme (no name: list them)

${C_BOLD}USAGE${C_OFF}
  prama-agent                          Opens the interactive interface
  prama-agent <agent> <zone> [opts] [-- agent args]
  prama-agent <subcommand> [args]

${C_BOLD}LAUNCH${C_OFF}  agents: ${AGENTS[*]}  ·  zones: ${ZONES[*]}
  --role, -O <role>      executor | coordinator | reader | daemon
  --ask | --plan | --yolo  permissions (default: $1)
  --remote | --no-remote   native Remote Control (claude/agy)
  --model, -m <model>    claude: opus|sonnet|haiku…  agy: prama-agent fleet models agy
  --effort <level>       low | medium | high | xhigh | max (claude)
  --preset <name>        profile with skills/plugins/prompt (prama-agent fleet presets)
  --profile, -P <prof>   ${AVAILABLE_PROFILES[*]} (endpoints for claude)
  --worktree, -w <branch>  isolate in a git worktree (outside the repo)
  --name, -n <session>   custom session name
  --bg, -d               launch in the background   --porcelain  print only the name
  --parallel             another instance if one already exists
  --loop <sec> --task "<t>"  daemon with a recurring task   --oneshot  run once
  --direct               no tmux (direct exec)      --dry-run  show the command

${C_BOLD}SESSIONS${C_OFF}
  status | ls            Fleet panel                   sessions --json   Listing for scripts
  attach | a [session]   Connect (Ctrl+b d or $PRAMA_MENU_KEY to leave)
  logs <session> [N]     Last N lines                  capture <session> [N]  Plain text
  send <session> "<txt>" Type into the agent           restart <session>  Relaunch
  stop <session> | stop --all [-y]

${C_BOLD}FLEET${C_OFF}  (what the coordinator uses to manage agents)
  fleet status [--json]  State, blockers (login/quota/credit/model) and model of each agent
  fleet spawn <agent> <zone> [--model M] [--preset P] [--task "…"]   Launch an extra agent
  fleet model <session> <model>   fleet edit <session> …   fleet restart|kill <session>
  fleet presets | models [agent] | watchdog [status|start|stop|logs] | hooks [status|install|uninstall]

${C_BOLD}TEAMS${C_OFF}
  swarm <zone> --team <name> [--workers agy:3] [--task "goal"]   Coordinator + N agents
  teams                  Active teams (several per zone: architecture, security, docs…)
  swarm stop <zone> [--team <name>|--all]      cockpit [zone|session] [--team <name>]
  bus status|assign|report|inbox|broadcast|watch|clear|help            Messages between agents
  memory [show|add|clear] [<zone>|<session>] [--team T] [--zone-wide]   Team and zone memory (survives restarts)
  Inside tmux: $PRAMA_MENU_KEY menu · $PRAMA_NAV_KEY agent list · $PRAMA_COCKPIT_KEY cockpit ⇄ agent · Ctrl+b n/p next

${C_BOLD}SYSTEM${C_OFF}
  worktree list|create|remove|prune   profiles   mcp   agents [--json]
  worktree status|merge|sync|clean    isolated teams: each worker's branch, integrate, catch up, clean
  telegram setup|start|stop|restart|status|logs|test|notify|alerts|mute   doctor [--restore-tmux-conf]
  feedback "<bug>" | list | show <id> | export <id> | close <id>   prama bug reports (from agents)
  completion bash        Shell completion         info  Quick guide           update [version]  Update
EOF
}

_usage_es() {
  cat <<EOF
${C_BOLD}prama-agent v$VERSION${C_OFF} — control plane para agentes de código en terminal

${C_BOLD}PRIMEROS PASOS${C_OFF}
  setup                  Asistente: agentes y sesión, zonas, permisos (repetible; --check solo revisa)
  login [agente]         Estado de sesión de cada agente / iniciar sesión (claude, agy)
  zones [add <nombre> <carpeta> | remove <nombre> | scan]   Carpetas de trabajo con nombre corto
  lang [en|es|auto]      Idioma de la interfaz    theme [nombre]  Tema de colores (sin nombre: los lista)

${C_BOLD}USO${C_OFF}
  prama-agent                          Abre la interfaz interactiva
  prama-agent <agente> <zona> [opc.] [-- args del agente]
  prama-agent <subcomando> [args]

${C_BOLD}LANZAR${C_OFF}  agentes: ${AGENTS[*]}  ·  zonas: ${ZONES[*]}
  --role, -O <rol>       executor | coordinator | reader | daemon
  --ask | --plan | --yolo  permisos (por defecto: $1)
  --remote | --no-remote   Remote Control nativo (claude/agy)
  --model, -m <modelo>   claude: opus|sonnet|haiku…  agy: prama-agent fleet models agy
  --effort <nivel>       low | medium | high | xhigh | max (claude)
  --preset <nombre>      perfil con skills/plugins/prompt (prama-agent fleet presets)
  --profile, -P <perfil> ${AVAILABLE_PROFILES[*]} (endpoints para claude)
  --worktree, -w <rama>  aislar en un git worktree (fuera del repo)
  --name, -n <sesión>    nombre de sesión personalizado
  --bg, -d               lanzar en segundo plano   --porcelain  imprime solo el nombre
  --parallel             otra instancia si ya existe
  --loop <seg> --task "<t>"  daemon con tarea recurrente   --oneshot  una sola ejecución
  --direct               sin tmux (exec directo)   --dry-run  muestra el comando

${C_BOLD}SESIONES${C_OFF}
  status | ls            Panel de la flota             sessions --json   Listado para scripts
  attach | a [sesión]    Conectar (Ctrl+b d o $PRAMA_MENU_KEY para salir)
  logs <sesión> [N]      Últimas N líneas              capture <sesión> [N]  Texto plano
  send <sesión> "<txt>"  Escribir en el agente         restart <sesión>  Relanzar
  stop <sesión> | stop --all [-y]

${C_BOLD}FLOTA${C_OFF}  (lo que usa el coordinador para administrar agentes)
  fleet status [--json]  Estado, bloqueos (login/cuota/crédito/modelo) y modelo de cada agente
  fleet spawn <agente> <zona> [--model M] [--preset P] [--task "…"]   Lanzar un agente extra
  fleet model <sesión> <modelo>   fleet edit <sesión> …   fleet restart|kill <sesión>
  fleet presets | models [agente] | watchdog [status|start|stop|logs] | hooks [status|install|uninstall]

${C_BOLD}EQUIPOS${C_OFF}
  swarm <zona> --team <nombre> [--workers agy:3] [--task "objetivo"]   Coordinador + N agentes
  teams                  Equipos activos (varios por zona: arquitectura, seguridad, docs…)
  swarm stop <zona> [--team <nombre>|--all]      cockpit [zona|sesión] [--team <nombre>]
  bus status|assign|report|inbox|broadcast|watch|clear|help            Mensajes entre agentes
  memory [show|add|clear] [<zona>|<sesión>] [--team T] [--zone-wide]   Memoria del equipo y la zona (sobrevive reinicios)
  Dentro de tmux: $PRAMA_MENU_KEY menú · $PRAMA_NAV_KEY lista de agentes · $PRAMA_COCKPIT_KEY cockpit ⇄ agente · Ctrl+b n/p siguiente

${C_BOLD}SISTEMA${C_OFF}
  worktree list|create|remove|prune   profiles   mcp   agents [--json]
  worktree status|merge|sync|clean    equipos aislados: rama de cada ejecutor, integrar, poner al día, limpiar
  telegram setup|start|stop|restart|status|logs|test|notify|alerts|mute   doctor [--restore-tmux-conf]
  feedback "<fallo>" | list | show <id> | export <id> | close <id>   Reportes de fallos de prama (agentes)
  completion bash        Autocompletado           info  Guía rápida           update [versión]  Actualizar
EOF
}

# Updates an installation that is a git clone (the installer's and the developer's case).
subcmd_update() {
  local ref=${1:-} before after
  git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1 \
    || die "$(_t 'This installation is not a git clone (%s): reinstall with the one-line installer.' "$REPO_ROOT")"
  [ -z "$(git -C "$REPO_ROOT" status --porcelain --untracked-files=no 2>/dev/null)" ] \
    || die "$(_t 'There are local changes in %s; stash them (git stash) before updating.' "$REPO_ROOT")"
  before=$(git -C "$REPO_ROOT" rev-parse --short HEAD)
  git -C "$REPO_ROOT" fetch -q --tags origin || die "$(_t 'Could not reach the remote repository.')"
  if [ -n "$ref" ]; then git -C "$REPO_ROOT" checkout -q "$ref" || die "$(_t "Version '%s' does not exist." "$ref")"
  else git -C "$REPO_ROOT" pull -q --ff-only || die "$(_t 'Could not fast-forward the current branch (has it diverged?).')"; fi
  after=$(git -C "$REPO_ROOT" rev-parse --short HEAD)
  if [ "$before" = "$after" ]; then ok "$(_t 'You already have the latest version (v%s, %s).' "$VERSION" "$after")"
  else ok "$(_t 'Updated: %s → %s (%s).' "$before" "$after" "$("$SELF_PATH" --version)")"; fi
  "$SELF_PATH" doctor >/dev/null 2>&1 || true   # regenerates tmux.conf, hooks, migrations
  if [ "$before" != "$after" ]; then
    # Long-running prama processes keep the code they started with: restart them on the new one.
    if watchdog_running; then
      "$SELF_PATH" fleet watchdog stop >/dev/null 2>&1; "$SELF_PATH" fleet watchdog start >/dev/null 2>&1 \
        && ok "$(_t 'Watchdog restarted on the new version.')"
    fi
    if tmx_has "${PRAMA_SESSION_PREFIX}-telegram-bot"; then
      "$SELF_PATH" telegram restart >/dev/null 2>&1 && ok "$(_t 'Telegram bot restarted on the new version.')"
    fi
  fi
  info_msg "$(_t 'Running agents keep the previous version until you restart them (prama-agent fleet restart <session>).')"
}

subcmd_info() {
  refresh_dimensions
  printf '\n'
  box_top "❖ $(_t 'QUICK GUIDE')" "v$VERSION" "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}$(_t 'Back to the menu from an agent')${C_OFF}"
  box_row "$C_BORDER_HI" "  $(_t 'Tap %s in the bottom bar, or press %s / %s.' "${C_NEON}◂ MENU${C_OFF}" "${KEY_BADGE} $PRAMA_MENU_KEY ${C_OFF}" "${KEY_BADGE} Ctrl+b d ${C_OFF}")"
  box_row "$C_BORDER_HI" "  $(_t 'The agent keeps running in the background.')"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}$(_t 'Move between agents')${C_OFF}"
  box_row "$C_BORDER_HI" "  $(_t '%s agent list · %s team cockpit ⇄ agent · %s next' "${KEY_BADGE} $PRAMA_NAV_KEY ${C_OFF}" "${KEY_BADGE} $PRAMA_COCKPIT_KEY ${C_OFF}" "${KEY_BADGE} Ctrl+b n ${C_OFF}")"
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}$(_t 'Agents working together')${C_OFF}"
  box_row "$C_BORDER_HI" "  $(_t '%s in the menu or %sprama-agent swarm <zone>%s: coordinator + agents.' "${KEY_BADGE} s ${C_OFF}" "$C_NEON" "$C_OFF")"
  box_row "$C_BORDER_HI" "  $(_t 'They talk over the bus: %sbus assign%s / %sbus report%s.' "$C_NEON" "$C_OFF" "$C_NEON" "$C_OFF")"
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}$(_t 'From your phone')${C_OFF}"
  box_row "$C_BORDER_HI" "  $(_t 'Terminal: use mosh; the cockpit shows one agent per screen (◀ ▶).')"
  box_row "$C_BORDER_HI" "  $(_t 'No terminal: %sprama-agent telegram setup%s (teams, quota, reports).' "$C_NEON" "$C_OFF")"
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}$(_t 'Permissions')${C_OFF}"
  box_row "$C_BORDER_HI" "  $(perm_badge ask)  ·  $(perm_badge plan)  ·  $(perm_badge yolo)"
  box_row "$C_BORDER_HI" "  $(_t 'YOLO only on isolated servers: the agent runs commands without asking.')"
  box_bottom "Apache-2.0" "$C_BORDER_HI"
  printf '\n'
}

# Collects one line per session: name|pane_pid|cmd|path|dead|attached
list_panes_raw() {
  tmx list-panes -a -F '#{session_name}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}|#{pane_dead}|#{session_attached}' 2>/dev/null \
    | awk -F'|' '!seen[$1]++'
}

subcmd_status() {
  refresh_dimensions
  state_gc
  printf '\n'
  box_top "✦ $PRAMA_BRAND · $(_t 'FLEET')" "$(host_stats_label)" "$C_BORDER_HI"
  local panes count=0 h_s h_r h_st h_z
  panes=$(list_panes_raw)
  if [ -z "$panes" ]; then
    box_row "$C_BORDER_HI" "${C_MUTED}$(_t 'No agents running.')${C_OFF}"
    box_row "$C_BORDER_HI" "$(_t 'Launch one with %sprama-agent%s (interface) or %sprama-agent claude <zone>%s.' "$C_NEON" "$C_OFF" "$C_NEON" "$C_OFF")"
  else
    _tv h_s 'SESSION'; _tv h_r 'ROLE'; _tv h_st 'STATE'; _tv h_z 'ZONE / BRANCH'
    # Column widths in display columns (translations may carry accents).
    ui_fit "$h_s" 28; h_s=$UI_S; ui_fit "$h_r" 15; h_r=$UI_S; ui_fit "$h_st" 11; h_st=$UI_S
    box_row "$C_BORDER_HI" "$(printf '%s%s %s %s %-6s %-7s %s%s' "$C_MUTED" "$h_s" "$h_r" "$h_st" CPU RAM "$h_z" "$C_OFF")"
    box_sep "$C_BORDER_HI"
    local s ppid pcmd ppath dead _att a_pid cpu mem _et comm st branch
    while IFS='|' read -r s ppid pcmd ppath dead _att; do
      [ -z "$s" ] && continue
      (( count++ ))
      a_pid=$(resolve_pane_agent_pid "$ppid")
      IFS='|' read -r cpu mem _et comm <<< "$(get_proc_metrics "$a_pid")"
      st=$(detect_session_state "$s" "$dead" "$pcmd")
      branch=$(git -C "$ppath" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
      box_row "$C_BORDER_HI" "$(printf '%s%-28s%s %-15s %s %-5s %-7s %s' \
        "$C_BOLD" "$(truncate_cols "$s" 28)" "$C_OFF" "$(role_badge "$(session_role "$s")")" \
        "$(state_badge "$st")$(repeat_char ' ' $(( 9 - ${#st} )))" "${cpu%.*}%" "$mem" \
        "$(basename "$ppath")${branch:+ ⎇ $branch}")"
    done <<< "$panes"
  fi
  box_bottom "$(_t '%d sessions · attach <s> · logs <s> · stop <s>' "$count")" "$C_BORDER_HI"

  local unmanaged
  unmanaged=$(find_unmanaged_agents)
  if [ -n "$unmanaged" ]; then
    printf '\n'
    box_top "$(_t '▲ AGENTS OUTSIDE PRAMA (lost if SSH drops)')" "" "$C_BRASS"
    local u_pid u_tty u_comm u_cpu u_mem u_et u_cwd
    while IFS='|' read -r u_pid u_tty u_comm u_cpu u_mem u_et u_cwd; do
      box_row "$C_BRASS" "$(printf '%-8s %-8s %-7s %-6s %-7s %s' "$u_pid" "$u_comm" "$u_tty" "$u_cpu" "$u_mem" "$u_cwd")"
    done <<< "$unmanaged"
    box_bottom "$(_t 'Launch them with prama-agent so they survive')" "$C_BRASS"
  fi
  printf '\n'
}

subcmd_sessions() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local panes s ppid pcmd ppath dead att a_pid cpu mem _et comm first=1 internal
  panes=$(list_panes_raw)
  (( json )) && printf '['
  while IFS='|' read -r s ppid pcmd ppath dead att; do
    [ -z "$s" ] && continue
    if (( ! json )); then printf '%s\n' "$s"; continue; fi
    a_pid=$(resolve_pane_agent_pid "$ppid")
    IFS='|' read -r cpu mem _et comm <<< "$(get_proc_metrics "$a_pid")"
    internal=false; is_internal_session "$s" && internal=true
    (( first )) || printf ','
    first=0
    printf '{"name":"%s","role":"%s","state":"%s","agent":"%s","zone":"%s","cpu":"%s","mem":"%s","dir":"%s","attached":%s,"internal":%s}' \
      "$(json_escape "$s")" "$(session_role "$s")" "$(detect_session_state "$s" "$dead" "$pcmd")" \
      "$(json_escape "$(state_get "$s" AGENT "$comm")")" "$(json_escape "$(state_get "$s" ZONE)")" \
      "$cpu" "$mem" "$(json_escape "$ppath")" "$( (( att > 0 )) && echo true || echo false)" "$internal"
  done <<< "$panes"
  (( json )) && printf ']\n'
  return 0
}

subcmd_agents() {
  local i
  if [ "${1:-}" = "--json" ]; then
    printf '['
    for i in "${!AGENTS[@]}"; do
      (( i )) && printf ','
      printf '{"name":"%s","installed":%s}' "${AGENTS[$i]}" "$(agent_installed "${AGENTS[$i]}" && echo true || echo false)"
    done
    printf ']\n'
  else
    for i in "${!AGENTS[@]}"; do
      printf '%-8s %s\n' "${AGENTS[$i]}" "$(command -v "${AGENTS[$i]}" 2>/dev/null || _t '(not installed)')"
    done
  fi
}

subcmd_attach() {
  local target=${1:-}
  ensure_tmux_conf
  if [ -z "$target" ]; then
    mapfile -t _ss < <(prama_sessions)
    case ${#_ss[@]} in
      0) die "$(_t "No active sessions. Open the interface with 'prama-agent' to launch one.")" ;;
      1) target=${_ss[0]} ;;
      *)
        if command -v fzf >/dev/null 2>&1 && (( IS_TTY )); then
          target=$(printf '%s\n' "${_ss[@]}" | fzf --height=40% --border=rounded --prompt="$(_t 'session › ')") || exit 0
        else
          PS3=$(_t 'Session: ')
          select target in "${_ss[@]}"; do [ -n "$target" ] && break; done
        fi ;;
    esac
  fi
  require_session "$target"
  tmx_attach "$target" 1
}

subcmd_stop() {
  local target=${1:-} yes=0
  [ "${2:-}" = "-y" ] || [ "${2:-}" = "--yes" ] && yes=1
  [ -n "$target" ] || die "$(_t 'Usage: prama-agent stop <session> | stop --all [-y]')"
  if [ "$target" = "--all" ]; then
    mapfile -t _ss < <(prama_sessions)
    (( ${#_ss[@]} )) || { info_msg "$(_t 'No active agent sessions.')"; return 0; }
    if (( ! yes )); then
      (( IS_TTY )) || die "$(_t "No interactive terminal: use 'stop --all -y' to confirm.")"
      _t ' %d sessions will be closed: %s\n Continue? [y/N] ' "${#_ss[@]}" "${_ss[*]}"
      local a; IFS= read -r a
      [[ "$a" =~ ^[sSyY]$ ]] || { info_msg "$(_t 'Cancelled.')"; return 0; }
    fi
    local s
    for s in "${_ss[@]}"; do
      tmx_kill "$s" && state_remove "$s" && bus_event stopped operator "$s" "" && ok "$(_t "Session '%s' closed." "$s")"
    done
    return 0
  fi
  require_session "$target"
  tmx_kill "$target"
  state_remove "$target"
  bus_event stopped operator "$target" ""
  ok "$(_t "Session '%s' closed." "$target")"
}

subcmd_restart() {
  require_session "${1:-}"
  tmx respawn-pane -k -t "=$1:" && ok "$(_t "Agent relaunched in '%s' (history is kept)." "$1")"
}

subcmd_logs() {
  local target=${1:-} lines=${2:-80}
  require_session "$target"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "$(_t 'N must be a number.')"
  refresh_dimensions
  if (( IS_TTY )) && command -v less >/dev/null 2>&1 && (( lines > ${ROWS:-24} )); then
    tmx_capture "$target" "$lines" 1 | less -R +G
  else
    box_top "◉ $target" "$(_t 'last %s lines' "$lines")" "$C_BORDER_HI"
    tmx_capture "$target" "$lines" "$IS_TTY"
    box_bottom "prama-agent attach $target" "$C_BORDER_HI"
  fi
}

subcmd_capture() {
  local lines=${2:-40}
  require_session "${1:-}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "$(_t 'N must be a number.')"
  tmx_capture "$1" "$lines" 0
}

subcmd_send() {
  local target=${1:-}
  shift || true
  local text="$*"
  [ -n "$target" ] && [ -n "$text" ] || die "$(_t 'Usage: prama-agent send <session> "<text>"')"
  require_session "$target"
  tmx_send "$target" "$text" && ok "$(_t "Sent to '%s'." "$target")"
}

subcmd_worktree() {
  local action=${1:-list}
  shift || true
  refresh_dimensions
  case "$action" in
    list|ls)
      box_top "⎇ GIT WORKTREES" "" "$C_BORDER_HI"
      local i dir line
      for i in "${!ZONES[@]}"; do
        dir=${ZONE_DIRS[$i]}
        git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
        box_row "$C_BORDER_HI" "${C_LIVE}▸ ${C_BOLD}${ZONES[$i]}${C_OFF} ${C_MUTED}$dir${C_OFF}"
        while IFS= read -r line; do box_row "$C_BORDER_HI" "   $line"; done < <(git -C "$dir" worktree list)
      done
      box_bottom "$(_t 'create: prama-agent worktree create <zone> <branch>')" "$C_BORDER_HI" ;;
    create|add)
      local zone=${1:-} branch=${2:-} dir wt
      [ -n "$zone" ] && [ -n "$branch" ] || die "$(_t 'Usage: prama-agent worktree create <zone> <branch>')"
      dir=$(zone_dir "$zone") || die "$(_t "Zone '%s' not found." "$zone")"
      wt=$(provision_worktree "$dir" "$branch") || exit 1
      ok "$(_t 'Worktree ready at: %s' "$wt")" ;;
    remove|rm)
      local zone=${1:-} branch=${2:-} dir wt
      [ -n "$zone" ] && [ -n "$branch" ] || die "$(_t 'Usage: prama-agent worktree remove <zone> <branch>')"
      dir=$(zone_dir "$zone") || die "$(_t "Zone '%s' not found." "$zone")"
      wt=$(worktree_path "$dir" "$branch")
      [ -d "$wt" ] || die "$(_t 'Worktree %s does not exist' "$wt")"
      git -C "$dir" worktree remove "$wt" \
        || die "$(_t 'Git refused to remove %s (unsaved changes?). Check and use: git -C %s worktree remove --force %s' "$wt" "$dir" "$wt")"
      ok "$(_t "Worktree removed: %s (branch '%s' is kept)" "$wt" "$branch")" ;;
    status|st)  wt_status "$@" ;;
    merge)      wt_merge "$@" ;;
    sync)       wt_sync "$@" ;;
    clean)
      _wt_resolve_coord "${1:-}" "${3:-}"
      _wt_authorize "$WT_COORD"
      wt_clean_team "$WT_COORD" ;;
    prune)
      local i
      for i in "${!ZONES[@]}"; do
        git -C "${ZONE_DIRS[$i]}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
        git -C "${ZONE_DIRS[$i]}" worktree prune -v && ok "$(_t 'Pruned: %s' "${ZONES[$i]}")"
      done ;;
    *) die "$(_t "Unknown action: '%s' (list | create | remove | prune | status | merge | sync | clean)" "$action")" ;;
  esac
}

subcmd_profiles() {
  refresh_dimensions
  box_top "⚙ $(_t 'LLM PROFILES')" "--profile" "$C_BORDER_HI"
  local h_p h_st h_m
  _tv h_p 'PROFILE'; _tv h_st 'STATUS'; _tv h_m 'MODEL'
  box_row "$C_BORDER_HI" "$(printf '%s%-16s %-14s %-38s %s%s' "$C_MUTED" "$h_p" "$h_st" ENDPOINT "$h_m" "$C_OFF")"
  box_sep "$C_BORDER_HI"
  _prof_row() {
    local name=$1 key=$2 url=$3 model=$4 st lbl
    if [ "$key" = native ]; then _tv lbl '● native'; st=$C_LIVE
    elif [ "$key" = local ]; then _tv lbl '● local proxy'; st=$C_NEON
    elif [ -n "$key" ]; then _tv lbl '● with key'; st=$C_LIVE
    else _tv lbl '○ missing key'; st=$C_BRASS; fi
    st+="$lbl${C_OFF}$(repeat_char ' ' $(( 14 - ${#lbl} )))"
    box_row "$C_BORDER_HI" "$(printf '%s%-16s%s %s %-38s %s' "$C_BOLD" "$name" "$C_OFF" "$st" "$(truncate_cols "$url" 38)" "$model")"
  }
  _prof_row default native "$(_t 'CLI subscription')" "—"
  _prof_row deepseek "${DEEPSEEK_API_KEY:-}" "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}" "${DEEPSEEK_MODEL:-deepseek-chat}"
  _prof_row glm "${GLM_API_KEY:-}" "${GLM_BASE_URL:-https://open.bigmodel.cn/api/anthropic}" "${GLM_MODEL:-glm-4.6}"
  _prof_row openrouter "${OPENROUTER_API_KEY:-}" "${OPENROUTER_ANTHROPIC_URL:-https://openrouter.ai/api}" "${OPENROUTER_MODEL:-(--model)}"
  _prof_row local local "${LOCAL_ROUTER_URL:-http://127.0.0.1:3456}" "${LOCAL_ROUTER_MODEL:-default}"
  box_sep "$C_BORDER_HI"
  is_in opencode "${AGENTS[@]}" && box_row "$C_BORDER_HI" "${C_MUTED}$(_t 'opencode uses OpenRouter directly: OPENROUTER_API_KEY %s · default model %s' "$( [ -n "${OPENROUTER_API_KEY:-}" ] && printf '%s%s%s' "$C_LIVE" "$(_t '● configured')" "$C_MUTED" || printf '%s%s%s' "$C_BRASS" "$(_t '○ missing')" "$C_MUTED")" "$PRAMA_OPENCODE_MODEL")${C_OFF}"
  box_bottom "$(_t 'keys in %s/providers.env (chmod 600)' "$PRAMA_CONFIG_HOME")" "$C_BORDER_HI"
}

subcmd_mcp() {
  refresh_dimensions
  box_top "☍ $(_t 'MCP SERVERS')" "" "$C_BORDER_HI"
  local line i dir
  if agent_installed agy; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ agy${C_OFF}"
    while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(timeout 10 agy mcp list 2>&1)
  fi
  if agent_installed claude; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ claude${C_OFF}"
    while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(timeout 15 claude mcp list 2>&1)
  fi
  for i in "${!ZONES[@]}"; do
    dir=${ZONE_DIRS[$i]}
    [ -f "$dir/.mcp.json" ] || continue
    box_row "$C_BORDER_HI" "${C_LIVE}▸ ${ZONES[$i]}${C_OFF} ${C_MUTED}$dir/.mcp.json${C_OFF}"
    if command -v jq >/dev/null 2>&1; then
      while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(jq -r '.mcpServers // {} | keys[]' "$dir/.mcp.json" 2>&1)
    fi
  done
  box_bottom "" "$C_BORDER_HI"
}

subcmd_doctor() {
  local restore=0
  [ "${1:-}" = "--restore-tmux-conf" ] && restore=1
  refresh_dimensions
  local good="${C_LIVE}✔${C_OFF}" bad="${C_ERR}✖${C_OFF}" meh="${C_BRASS}▲${C_OFF}"
  printf '\n'
  box_top "⚙ DOCTOR" "v$VERSION" "$C_BORDER_HI"

  ensure_tmux_conf 1
  box_row "$C_BORDER_HI" "$good $(_t 'prama tmux config regenerated') ${C_MUTED}($PRAMA_TMUX_CONF)${C_OFF}"

  local tv
  tv=$(tmux -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
  if awk -v v="${tv:-0}" 'BEGIN{exit !(v >= 3.2)}'; then
    box_row "$C_BORDER_HI" "$good tmux $tv"
  else
    box_row "$C_BORDER_HI" "$meh $(_t 'tmux %s: >= 3.2 recommended' "${tv:-?}")"
  fi

  local dep
  for dep in git fzf jq python3 curl flock less; do
    if command -v "$dep" >/dev/null 2>&1; then
      box_row "$C_BORDER_HI" "$good $dep"
    else
      case "$dep" in
        git) box_row "$C_BORDER_HI" "$bad $(_t 'git not found (needed for zones and worktrees)')" ;;
        python3|curl) box_row "$C_BORDER_HI" "$meh $(_t '%s not found (only needed for Telegram)' "$dep")" ;;
        *) box_row "$C_BORDER_HI" "$meh $(_t '%s not found (optional)' "$dep")" ;;
      esac
    fi
  done

  local a
  for a in "${AGENTS[@]}"; do
    if agent_installed "$a"; then
      box_row "$C_BORDER_HI" "$good $(_t 'agent %s' "$a") ${C_MUTED}$(command -v "$a")${C_OFF}"
    else
      case "$a" in
        opencode) box_row "$C_BORDER_HI" "${C_MUTED}$(_t '○ agent opencode not installed (npm i -g @opencode/cli)')${C_OFF}" ;;
        *)        box_row "$C_BORDER_HI" "${C_MUTED}$(_t '○ agent %s not installed' "$a")${C_OFF}" ;;
      esac
    fi
  done
  if (( ${#DROPPED_AGENTS[@]} )); then
    box_row "$C_BORDER_HI" "$meh $(_t 'AGENTS in config.env includes agents that are not enabled (%s): ignored' "${DROPPED_AGENTS[*]}")"
    is_in opencode "${DROPPED_AGENTS[@]}" && box_row "$C_BORDER_HI" "${C_MUTED}  $(_t 'opencode is experimental: PRAMA_EXPERIMENTAL=1 enables it')${C_OFF}"
  fi
  if is_in opencode "${AGENTS[@]}" && [ -z "${OPENROUTER_API_KEY:-}" ]; then
    box_row "$C_BORDER_HI" "$meh $(_t "opencode without OPENROUTER_API_KEY in providers.env (or use 'opencode auth login')")"
  fi
  if command -v mosh-server >/dev/null 2>&1; then box_row "$C_BORDER_HI" "$good mosh ${C_MUTED}$(_t '(stable connection from your phone: mosh <server> -- prama-agent)')${C_OFF}"
  else box_row "$C_BORDER_HI" "${C_MUTED}$(_t '○ mosh not installed (optional, recommended for phones: sudo apt install mosh)')${C_OFF}"; fi
  if watchdog_running; then box_row "$C_BORDER_HI" "$good $(_t 'fleet watchdog running')"
  else box_row "$C_BORDER_HI" "${C_MUTED}$(_t '○ watchdog stopped (starts with the first agent)')${C_OFF}"; fi
  if agent_installed agy && (( ${PRAMA_HOOKS:-1} )); then
    if agy_hooks_installed; then box_row "$C_BORDER_HI" "$good $(_t 'agy hooks installed (~/.gemini/config/hooks.json)')"
    else box_row "$C_BORDER_HI" "${C_MUTED}$(_t '○ agy hooks: installed when agy is launched (prama-agent fleet hooks)')${C_OFF}"; fi
  fi
  command -v jq >/dev/null 2>&1 || box_row "$C_BORDER_HI" "$meh $(_t 'jq not installed: no quota telemetry or agy hooks (sudo apt install jq)')"

  box_row "$C_BORDER_HI" "$good $(_t 'Private state (0700)') ${C_MUTED}$PRAMA_STATE_HOME${C_OFF}"
  local fb; fb=$(feedback_open_count)
  if (( fb )); then box_row "$C_BORDER_HI" "$meh $(_t '%s unreviewed prama bug report(s): prama-agent feedback list' "$fb")"
  else box_row "$C_BORDER_HI" "$good $(_t 'No pending bug reports')"; fi
  state_gc

  if (( PRAMA_SKIP_PERMISSIONS )); then
    if (( EUID == 0 )); then
      box_row "$C_BORDER_HI" "$meh $(_t 'YOLO by default while running as root: use an unprivileged user or PRAMA_SKIP_PERMISSIONS=0')"
    else
      box_row "$C_BORDER_HI" "$meh $(_t 'YOLO enabled by default (PRAMA_SKIP_PERMISSIONS=1)')"
    fi
  fi

  # Detach clients idle for more than 6h (zombie SSH sessions that pin the window size)
  local c_tty c_sess c_act now detached=0
  now=$(date +%s)
  while IFS='|' read -r c_tty c_sess c_act; do
    [ -z "$c_tty" ] && continue
    if (( now - ${c_act:-$now} > 21600 )); then
      tmx detach-client -t "$c_tty" 2>/dev/null && (( detached++ ))
    fi
  done < <(tmx list-clients -F '#{client_name}|#{client_session}|#{client_activity}' 2>/dev/null)
  box_row "$C_BORDER_HI" "$good $(_t 'Idle clients detached: %s' "$detached")"

  local i
  for i in "${!ZONES[@]}"; do
    git -C "${ZONE_DIRS[$i]}" worktree prune 2>/dev/null || true
  done
  box_row "$C_BORDER_HI" "$good $(_t 'Worktree metadata cleaned up')"

  # ── Migration from v5 ──
  if [ -d /tmp/prama-bus ] && [ "$(stat -c %u /tmp/prama-bus 2>/dev/null)" = "$EUID" ]; then
    rm -rf /tmp/prama-bus && box_row "$C_BORDER_HI" "$good $(_t 'Removed the insecure v5 bus (%s)' /tmp/prama-bus)"
  elif [ -d /tmp/prama-bus ]; then
    box_row "$C_BORDER_HI" "$meh $(_t '%s exists and belongs to another user: check it (possible attack)' /tmp/prama-bus)"
  fi
  if grep -q 'prama-agent-managed' "$HOME/.tmux.conf" 2>/dev/null; then
    if (( restore )); then
      mv -f "$HOME/.tmux.conf" "$HOME/.tmux.conf.prama-v5"
      if [ -f "$HOME/.tmux.conf.bak" ] && ! grep -q 'prama-agent-managed' "$HOME/.tmux.conf.bak"; then
        cp -p "$HOME/.tmux.conf.bak" "$HOME/.tmux.conf"
        box_row "$C_BORDER_HI" "$good $(_t 'Original ~/.tmux.conf restored from .bak')"
      else
        box_row "$C_BORDER_HI" "$good $(_t 'v5 ~/.tmux.conf retired (saved as ~/.tmux.conf.prama-v5)')"
      fi
    else
      box_row "$C_BORDER_HI" "$meh $(_t 'Your ~/.tmux.conf was overwritten by prama v5. Run: prama-agent doctor --restore-tmux-conf')"
    fi
  fi
  if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -q "^${PRAMA_SESSION_PREFIX}-"; then
    box_row "$C_BORDER_HI" "$meh $(_t "There are v5 '%s-*' sessions in your personal tmux; v6 uses its own server (tmux -L %s)." "$PRAMA_SESSION_PREFIX" "$PRAMA_TMUX_SOCKET")"
  fi

  local unmanaged
  unmanaged=$(find_unmanaged_agents)
  if [ -n "$unmanaged" ]; then
    box_row "$C_BORDER_HI" "$meh $(_t "%s agent(s) running outside prama (see 'prama-agent status')" "$(wc -l <<< "$unmanaged")")"
  fi
  box_bottom "$(_t 'checks done')" "$C_BORDER_HI"
  printf '\n'
}

subcmd_completion() {
  [ "${1:-bash}" = "bash" ] || die "$(_t 'Only bash is supported for now.')"
  cat <<'EOF'
# prama-agent bash completion — add to ~/.bashrc:  eval "$(prama-agent completion bash)"
_prama_agent() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} first=${COMP_WORDS[1]:-}
  local subs="status ls sessions attach logs capture send restart stop fleet swarm teams bus cockpit fzf worktree profiles mcp zones agents telegram feedback memory setup login lang theme doctor update completion info help"
  case "$prev" in
    --role|-O) COMPREPLY=($(compgen -W "executor coordinator reader daemon" -- "$cur")); return ;;
    --profile|-P) COMPREPLY=($(compgen -W "default openrouter deepseek glm local" -- "$cur")); return ;;
    --model|-m) COMPREPLY=($(compgen -W "opus sonnet haiku fable openrouter/qwen/qwen3-coder:free openrouter/moonshotai/kimi-k2 openrouter/z-ai/glm-4.6 openrouter/deepseek/deepseek-chat" -- "$cur")); return ;;
    --effort) COMPREPLY=($(compgen -W "low medium high xhigh max" -- "$cur")); return ;;
  esac
  case "$first" in
    attach|a|logs|capture|send|restart|stop)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(prama-agent sessions 2>/dev/null)" -- "$cur")); return ;;
    bus) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "status assign report inbox broadcast watch clear help" -- "$cur")); return ;;
    fleet)
      if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "status spawn model edit restart kill presets models watchdog hooks help" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 3 ]; then
        case "${COMP_WORDS[2]}" in
          model|edit|restart|kill) COMPREPLY=($(compgen -W "$(prama-agent sessions 2>/dev/null)" -- "$cur")) ;;
          spawn) COMPREPLY=($(compgen -W "$(prama-agent agents 2>/dev/null | awk '{print $1}')" -- "$cur")) ;;
        esac
      fi; return ;;
    swarm) COMPREPLY=($(compgen -W "list stop help --team --all --workers --coord --task --model --worker-model --no-open $(prama-agent zones 2>/dev/null | awk '{print $1}')" -- "$cur")); return ;;
    cockpit) COMPREPLY=($(compgen -W "$(prama-agent zones 2>/dev/null | awk '{print $1}') $(prama-agent sessions 2>/dev/null)" -- "$cur")); return ;;
    telegram) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "setup start stop restart status logs test notify alerts mute" -- "$cur")); return ;;
    worktree) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "list create remove prune status merge sync clean" -- "$cur")); return ;;
    feedback|bug) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "list show export close help" -- "$cur")); return ;;
    memory|memoria) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "list show add clear path help" -- "$cur")); return ;;
    zones) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "list add remove scan help" -- "$cur")); return ;;
    login) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(prama-agent agents 2>/dev/null | awk '{print $1}')" -- "$cur")); return ;;
    lang|language|idioma) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "en es auto" -- "$cur")); return ;;
    theme|tema|color)
      # "prama-agent theme --names" prints the theme names, one per line.
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(prama-agent theme --names 2>/dev/null)" -- "$cur")); return ;;
  esac
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$subs $(prama-agent agents 2>/dev/null | awk '{print $1}')" -- "$cur"))
  elif [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "--role --ask --plan --yolo --remote --no-remote --model --effort --preset --profile --worktree --name --bg --porcelain --parallel --loop --task --oneshot --direct --dry-run" -- "$cur"))
  else
    COMPREPLY=($(compgen -W "$(prama-agent zones 2>/dev/null | awk '{print $1}')" -- "$cur"))
  fi
}
complete -F _prama_agent prama-agent
EOF
}

# ── Internal runner (executed inside the tmux pane) ─────────────────────────
if [ "${1:-}" = "--internal-watchdog" ]; then
  watchdog_loop
  exit 0
fi
if [ "${1:-}" = "--internal-nav" ]; then
  shift
  nav_main "$@"
  exit 0
fi
if [ "${1:-}" = "--internal-runner" ]; then
  shift
  internal_runner "$@"
  exit $?
fi

# ── Subcommand dispatch ─────────────────────────────────────────────────────
if [ $# -gt 0 ]; then
  case $1 in
    status|ls|ps)          subcmd_status; exit 0 ;;
    sessions)              shift; subcmd_sessions "$@"; exit 0 ;;
    zones)                 shift; subcmd_zones "$@"; exit $? ;;
    setup|init)            shift; subcmd_setup "$@"; exit $? ;;
    login|auth)            shift; subcmd_login "$@"; exit $? ;;
    lang|language|idioma)  shift; subcmd_lang "$@"; exit $? ;;
    theme|tema|color)      shift; subcmd_theme "$@"; exit $? ;;
    agents)                shift; subcmd_agents "$@"; exit 0 ;;
    cockpit|ui|team)       shift; subcmd_cockpit "$@"; exit $? ;;
    swarm|equipo)          shift; subcmd_swarm "$@"; exit $? ;;
    teams|equipos)         shift; _swarm_list "$@"; exit $? ;;
    fzf|find)              launch_fzf_cockpit; exit $? ;;
    bus)                   shift; subcmd_bus "$@"; exit $? ;;
    fleet)                 shift; subcmd_fleet "$@"; exit $? ;;
    telegram|tg|bot)       shift; subcmd_telegram "$@"; exit $? ;;
    feedback|bug)          shift; subcmd_feedback "$@"; exit $? ;;
    memory|memoria|mem)    shift; subcmd_memory "$@"; exit $? ;;
    attach|a)              shift; subcmd_attach "${1:-}"; exit $? ;;
    stop|kill|k)           shift; subcmd_stop "$@"; exit $? ;;
    restart|r)             shift; subcmd_restart "${1:-}"; exit $? ;;
    logs|peek|log)         shift; subcmd_logs "${1:-}" "${2:-80}"; exit $? ;;
    capture)               shift; subcmd_capture "${1:-}" "${2:-40}"; exit $? ;;
    send|inject)           shift; subcmd_send "$@"; exit $? ;;
    worktree|worktrees|wt) shift; subcmd_worktree "$@"; exit $? ;;
    profiles|providers)    subcmd_profiles; exit 0 ;;
    mcp)                   subcmd_mcp; exit 0 ;;
    doctor|fix)            shift; subcmd_doctor "$@"; exit 0 ;;
    update|upgrade)        shift; subcmd_update "$@"; exit $? ;;
    completion)            shift; subcmd_completion "$@"; exit 0 ;;
    info|--info)           subcmd_info; exit 0 ;;
    -h|--help|help)        usage; exit 0 ;;
  esac
fi

# ── Launch arguments ────────────────────────────────────────────────────────
AGENT='' ZONE='' DRY=0 BG=0 DIRECT=0 ONESHOT=0 PARALLEL=0 PORCELAIN=0
REMOTE="$PRAMA_DEFAULT_REMOTE"
ROLE="$PRAMA_DEFAULT_ROLE"
PERM_MODE="ask"
(( PRAMA_SKIP_PERMISSIONS )) && PERM_MODE="yolo"
PERM_EXPLICIT=0 AGENT_EXPLICIT=0 ROLE_EXPLICIT=0 PROFILE_EXPLICIT=0
DAEMON_INTERVAL=60 DAEMON_TASK='' WORKTREE='' CUSTOM_NAME='' PROFILE='default'
PASS=()

need_arg() { [ "$1" -ge 2 ] || die "$2"; }

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run)          DRY=1; shift ;;
    --bg|-d|--detach)   BG=1; shift ;;
    --porcelain)        PORCELAIN=1; BG=1; shift ;;
    --direct|--no-tmux) DIRECT=1; shift ;;
    --oneshot)          ONESHOT=1; shift ;;
    --parallel)         PARALLEL=1; shift ;;
    --remote|-R)        REMOTE=1; shift ;;
    --no-remote)        REMOTE=0; shift ;;
    --safe|--ask)       PERM_MODE="ask"; PERM_EXPLICIT=1; shift ;;
    --yolo)             PERM_MODE="yolo"; PERM_EXPLICIT=1; shift ;;
    --plan|--readonly)  PERM_MODE="plan"; PERM_EXPLICIT=1; shift ;;
    --perm)
      need_arg $# "$(_t '--perm requires: %s' "${AVAILABLE_PERM_MODES[*]}")"
      is_in "$2" "${AVAILABLE_PERM_MODES[@]}" || die "$(_t '--perm must be: %s' "${AVAILABLE_PERM_MODES[*]}")"
      PERM_MODE=$2; PERM_EXPLICIT=1; shift 2 ;;
    --role|-O)
      need_arg $# "$(_t '--role requires: %s' "${AVAILABLE_ROLES[*]}")"
      is_in "$2" "${AVAILABLE_ROLES[@]}" || die "$(_t '--role must be: %s' "${AVAILABLE_ROLES[*]}")"
      ROLE=$2; ROLE_EXPLICIT=1; shift 2 ;;
    --model|-m)
      need_arg $# "$(_t '--model requires a model')"
      valid_model "$2" || die "$(_t "Invalid model: '%s'" "$2")"
      AGENT_MODEL=$2; shift 2 ;;
    --effort)
      need_arg $# "$(_t '--effort requires: low medium high xhigh max')"
      [[ "$2" =~ ^(low|medium|high|xhigh|max)$ ]] || die "$(_t '--effort must be: low medium high xhigh max')"
      AGENT_EFFORT=$2; shift 2 ;;
    --preset)
      need_arg $# "$(_t '--preset requires a name (prama-agent fleet presets)')"
      preset_find "$2" >/dev/null || die "$(_t "Unknown preset '%s'. Available: %s" "$2" "$(preset_names | tr '\n' ' ')")"
      PRESET=$2; shift 2 ;;
    --loop)
      need_arg $# "$(_t '--loop requires seconds')"
      [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 5 )) || die "$(_t '--loop requires a number of seconds >= 5')"
      DAEMON_INTERVAL=$2; ROLE="daemon"; shift 2 ;;
    --task)
      need_arg $# "$(_t '--task requires an instruction')"
      DAEMON_TASK=$2; shift 2 ;;
    --name|-n)
      need_arg $# "$(_t '--name requires a session name')"
      valid_session_name "$2" || die "$(_t "Invalid name '%s': use letters, digits, - and _ (max. 48)." "$2")"
      CUSTOM_NAME=$2; shift 2 ;;
    --worktree|-w)
      need_arg $# "$(_t '--worktree requires a branch name')"
      WORKTREE=$2; shift 2 ;;
    --profile|-P)
      need_arg $# "$(_t '--profile requires a profile')"
      is_in "$2" "${AVAILABLE_PROFILES[@]}" || die "$(_t "Unknown profile '%s'. Options: %s" "$2" "${AVAILABLE_PROFILES[*]}")"
      PROFILE=$2; PROFILE_EXPLICIT=1; shift 2 ;;
    --zone|-z)
      need_arg $# "$(_t '--zone requires a zone')"
      ZONE=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; PASS+=("$@"); break ;;
    *)
      if [ -z "$AGENT" ] && _m=$(match_one "$1" "${AGENTS[@]}"); then AGENT=$_m; AGENT_EXPLICIT=1
      elif [ -z "$ZONE" ] && _m=$(match_one "$1" "${ZONES[@]}"); then ZONE=$_m
      elif is_in "$1" "${AVAILABLE_ROLES[@]}"; then ROLE=$1; ROLE_EXPLICIT=1
      else PASS+=("$1"); fi
      shift ;;
  esac
done

# A preset may pick the agent, role and endpoint profile (explicit flags win).
preset_apply_defaults "$AGENT_EXPLICIT" "$ROLE_EXPLICIT" "$PROFILE_EXPLICIT" || exit 1

if [ "$ROLE" = "reader" ]; then
  [ "$PERM_EXPLICIT" = 1 ] && [ "$PERM_MODE" != "plan" ] && warn "$(_t 'The reader role forces plan mode (read-only).')"
  PERM_MODE="plan"
fi

# ── Interactive TUI ─────────────────────────────────────────────────────────
if [ -z "$AGENT" ] || [ -z "$ZONE" ]; then
  if (( ! ${IS_TERM:-$IS_TTY} )) || [ ! -t 0 ]; then
    [ -n "$AGENT" ] && die "$(_t 'Missing the zone. Available zones: %s' "${ZONES[*]}")"
    usage
    exit 1
  fi
  ensure_tmux_conf
  tui_main
  exit $?
fi

# ── Direct CLI launch ───────────────────────────────────────────────────────
if (( DRY || DIRECT )); then
  DIR=$(zone_dir "$ZONE") || die "$(_t "Zone '%s' is not registered." "$ZONE")"
  [ -d "$DIR" ] || die "$(_t "Directory '%s' of zone '%s' does not exist." "$DIR" "$ZONE")"
  agent_installed "$AGENT" || die "$(_t "Agent '%s' is not installed." "$AGENT")"
  SESSION_NAME=${CUSTOM_NAME:-$(session_name_for "$AGENT" "$ZONE" "$ROLE" "$WORKTREE")}
  TARGET_DIR=$DIR
  if [ -n "$WORKTREE" ]; then
    if (( DRY )); then TARGET_DIR=$(worktree_path "$DIR" "$WORKTREE")
    else TARGET_DIR=$(provision_worktree "$DIR" "$WORKTREE") || exit 1; fi
  fi
  ROLE_PROMPT=""
  [ "$ROLE" != "executor" ] && ROLE_PROMPT=$(build_role_system_prompt "$ROLE" "$SESSION_NAME" "$ZONE")
  PROFILE=$PROFILE build_agent_command "$AGENT" "$PERM_MODE" "$REMOTE" "$SESSION_NAME" "$ROLE_PROMPT" ${PASS[@]+"${PASS[@]}"}
  if (( DRY )); then
    printf -v ESCAPED '%q ' "${CMD[@]}"
    printf 'cd %q && ROLE=%q PERM=%q REMOTE=%q PROFILE=%q tmux -L %q new-session -s %q -- %s\n' \
      "$TARGET_DIR" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$PRAMA_TMUX_SOCKET" "$SESSION_NAME" "${ESCAPED% }"
    exit 0
  fi
  apply_provider_profile "$PROFILE"
  agent_runtime_env "$AGENT" "$SESSION_NAME" "$PERM_MODE" "$ROLE_PROMPT"
  cd "$TARGET_DIR" || die "$(_t 'Could not enter %s' "$TARGET_DIR")"
  if [ "$PERM_MODE" = "yolo" ]; then export IS_SANDBOX=1; else unset IS_SANDBOX; fi
  export PRAMA_SESSION="$SESSION_NAME" PRAMA_ROLE="$ROLE"
  exec "${CMD[@]}"
fi

MODE="attach"
(( BG )) && MODE="bg"
(( PORCELAIN )) && MODE="porcelain"
launch_agent "$AGENT" "$ZONE" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$WORKTREE" "$MODE" "$CUSTOM_NAME"
