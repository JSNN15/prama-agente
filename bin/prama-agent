#!/usr/bin/env bash
# prama-agent — Multi-Agent Terminal Control Plane, Swarm Bus, Telegram 24/7 Bridge & LLM Router
# Copyright 2026 Contributors
# Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0)

set -u

VERSION="5.0.0"
SELF_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
REPO_ROOT="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
LIB_DIR="$REPO_ROOT/lib"

for _p in "$HOME/.local/bin" "$HOME/.kimi-code/bin" "/usr/local/bin"; do
  [ -d "$_p" ] && [[ ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
export PATH

ORIG_LC_ALL=${LC_ALL-}
case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
  *[Uu][Tt][Ff]*8*) LC_SET=0 ;;
  *) export LC_ALL=C.UTF-8; LC_SET=1 ;;
esac

restore_locale() {
  if (( LC_SET )); then
    if [ -n "$ORIG_LC_ALL" ]; then export LC_ALL="$ORIG_LC_ALL"; else unset LC_ALL; fi
  fi
}

# Load modular architecture
# shellcheck disable=SC1091
source "$LIB_DIR/core.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/agents.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/roles.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/telegram.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/bus.sh"
# shellcheck disable=SC1091
source "$LIB_DIR/tui.sh"

# ── Subcommands ─────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${C_BOLD}Prama Agent Control Plane & Swarm Bus v$VERSION${C_OFF} (Apache-2.0)

${C_BOLD}USO:${C_OFF}
  prama-agent [agente] [zona] [opciones] [-- args del agente...]
  prama-agent <subcomando> [argumentos]

${C_BOLD}SUBCOMANDOS DE FLOTA, BUS MULTI-AGENTE, COCKPIT Y TELEGRAM:${C_OFF}
  status | list | ls           Dashboard de flota (sesiones tmux, roles, CPU/RAM, agentes sueltos)
  cockpit [zona] [coord] [exec]Lanza Cockpit Multi-Panel estilo Lazydocker (Coordinador + Ejecutor + Bus)
  fzf | find                   Abre el Inspector Split-Screen interactivo (fzf + tmux live preview)
  bus <status|assign|report|swarm-start|broadcast|watch|clear>
                               Bus de comunicación y cola de tareas entre agentes (claude/agy/kimi/...)
  telegram <setup|start|stop|status|notify>
                               Puente Bot de Telegram 24/7 (controla agentes aunque se cierre Termius)
  attach | a [sesión]          Reconecta a una sesión (desacopla clientes SSH zombis con -d)
  restart | r <sesión>         Reinicia el agente dentro de la sesión sin perder el scrollback
  stop | kill <sesión|--all>   Termina una sesión de agente (o todas con --all)
  logs | peek <sesión> [N]     Muestra las últimas N líneas (default 80) de la terminal del agente
  send <sesión> "<texto>"      Envía un prompt o comando directo a un agente en ejecución
  worktree | wt <acción>       Gestiona Git Worktrees (list, create, remove, prune) + copia .env
  profiles                     Lista los perfiles de enrutamiento LLM / API disponibles
  mcp [zona]                   Audita servidores MCP configurados
  doctor                       Limpia clientes SSH zombis, recarga tmux.conf y poda worktrees
  info                         Guía visual de atajos, roles y arquitectura

${C_BOLD}ROLES PREDEFINIDOS (--role / tecla [o]):${C_OFF}
  executor      ✦ Ejecutor de código y tests (permisos YOLO activos por defecto)
  coordinator   ❖ Coordinador / Arquitecto (planifica y delega vía 'prama-agent bus assign')
  reader        ◉ Lector / Auditor (fuerza modo SOLO LECTURA determinista: --mode plan / --plan)
  daemon        ♺ Esclavo / Daemon autónomo (ejecuta bucle continuo escuchando la cola del bus)
EOF
}

subcmd_status() {
  ensure_tmux_conf
  refresh_dimensions
  sync_bus_state
  local host_stats
  host_stats=$(get_host_telemetry)
  printf '\n'
  box_top "✦ PRAMA AGENT // FLEET STATUS" "$host_stats" "$C_BORDER_HI"

  if ! command -v tmux >/dev/null 2>&1; then
    die "tmux no está instalado en el servidor"
  fi

  local panes
  panes=$(tmux list-panes -a -F "#{session_name}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}|#{pane_dead}|#{session_attached}|#{session_created}" 2>/dev/null || true)

  if [ -z "$panes" ]; then
    box_row "$C_BORDER_HI" "  ${C_DIM}(No hay sesiones gestionadas en tmux actualmente)${C_OFF}"
  else
    local hdr
    hdr=$(printf '%s%-23s %-15s %-8s %-7s %-11s %-6s %s%s' \
      "$C_DIM" "SESION TMUX" "ROL" "ESTADO" "PID" "CPU LOAD" "RAM" "ZONA / RAMA" "$C_OFF")
    box_row "$C_BORDER_HI" "$hdr"
    box_sep "$C_BORDER_HI"

    while IFS='|' read -r s_name p_pid p_cmd p_path p_dead s_att _s_created; do
      [ -z "$s_name" ] && continue
      local a_pid metrics cpu mem etime comm state_raw state_lbl state_col branch gauge s_role="executor"
      if [ -f "$PRAMA_BUS_DIR/state/${s_name}.env" ]; then
        s_role=$(grep '^ROLE=' "$PRAMA_BUS_DIR/state/${s_name}.env" | cut -d'"' -f2 || echo "executor")
      fi
      a_pid=$(resolve_pane_agent_pid "$p_pid")
      metrics=$(get_proc_metrics "$a_pid")
      IFS='|' read -r cpu mem etime comm <<< "$metrics"
      state_raw=$(detect_pane_activity_state "$s_name" "$p_dead" "$comm")
      IFS='|' read -r state_lbl state_col <<< "$state_raw"
      gauge=$(draw_gauge "$cpu" 4)
      branch=$(git -C "$p_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      local dir_label="$p_path"
      [ -n "$branch" ] && dir_label="$p_path (⎇ $branch)"
      local r_line
      r_line=$(printf '%s%-23s%s %-15s %s%-8s%s %-7s %s %-5s %-6s %s' \
        "$C_BOLD" "$s_name" "$C_OFF" "$(role_badge "$s_role")" \
        "$state_col" "$state_lbl" "$C_OFF" "$a_pid" "$gauge" "${cpu}%" "$mem" "$dir_label")
      box_row "$C_BORDER_HI" "$r_line"
    done <<< "$panes"
  fi
  box_bottom "[↵] attach · [v] cockpit · [f] fzf · [t] assign task · [x] stop" "$C_BORDER_HI"

  local unmanaged
  unmanaged=$(find_unmanaged_agents)
  if [ -n "$unmanaged" ]; then
    printf '\n'
    box_top "▲ AGENTES FUERA DE TMUX (SIN PROTECCION SSH)" "RAW TTY" "$C_BRASS"
    local uhdr
    uhdr=$(printf '%s%-10s %-10s %-10s %-8s %-8s %-10s %s%s' \
      "$C_DIM" "PID" "TTY" "AGENTE" "CPU%" "RAM" "TIEMPO" "DIRECTORIO" "$C_OFF")
    box_row "$C_BRASS" "$uhdr"
    box_sep "$C_BRASS"
    while IFS='|' read -r u_pid u_tty u_comm u_cpu u_mem u_etime u_cwd; do
      [ -z "$u_pid" ] && continue
      local uline
      uline=$(printf '%-10s %-10s %-10s %-8s %-8s %-10s %s' \
        "$u_pid" "$u_tty" "$u_comm" "$u_cpu" "$u_mem" "$u_etime" "$u_cwd")
      box_row "$C_BRASS" "$uline"
    done <<< "$unmanaged"
    box_bottom "Lanza siempre con prama-agent para persistencia" "$C_BRASS"
  fi
  printf '\n'
}

# Used for direct CLI `prama-agent attach <session>`
attach_or_switch() {
  local target=$1
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "$target"
  else
    exec tmux attach-session -d -t "$target"
  fi
}

# Used inside the interactive Prama Agent TUI so detaching (Ctrl+g or tapping status bar) returns to the Main Menu!
attach_session_returnable() {
  local target=$1
  tui_leave_screen
  restore_locale
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$target"
  else
    tmux attach-session -d -t "$target" || true
  fi
  tui_enter_screen
}

subcmd_attach() {
  local target=${1:-}
  ensure_tmux_conf
  if [ -z "$target" ]; then
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)
    local count
    count=$(echo "$sessions" | grep -v '^$' | wc -l)
    if [ "$count" -eq 0 ]; then
      die "No hay sesiones activas en tmux. Usa 'prama-agent' para lanzar una."
    elif [ "$count" -eq 1 ]; then
      target=$(echo "$sessions" | head -n 1)
      ok "Conectando a la única sesión activa: $target"
    else
      printf '\n Múltiples sesiones activas. Selecciona una:\n'
      select opt in $sessions; do
        if [ -n "${opt:-}" ]; then target=$opt; break; fi
      done
    fi
  fi

  if ! tmux has-session -t "$target" 2>/dev/null; then
    die "La sesión '$target' no existe. Usa 'prama-agent status' para ver las activas."
  fi

  restore_locale
  attach_or_switch "$target"
}

subcmd_stop() {
  local target=${1:-}
  [ -z "$target" ] && die "Uso: prama-agent stop <nombre_sesión | --all>"
  if [ "$target" = "--all" ] || [ "$target" = "all" ]; then
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null || true)
    if [ -z "$sessions" ]; then
      warn "No hay sesiones activas en tmux."
      return 0
    fi
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      tmux kill-session -t "$s" 2>/dev/null && ok "Sesión '$s' terminada."
      rm -f "$PRAMA_BUS_DIR/state/${s}.env" 2>/dev/null || true
    done <<< "$sessions"
    return 0
  fi

  if tmux has-session -t "$target" 2>/dev/null; then
    tmux kill-session -t "$target"
    rm -f "$PRAMA_BUS_DIR/state/${target}.env" 2>/dev/null || true
    ok "Sesión '$target' terminada correctamente."
  else
    warn "La sesión '$target' no está activa."
  fi
}

subcmd_restart() {
  local target=${1:-}
  [ -z "$target" ] && die "Uso: prama-agent restart <nombre_sesión>"
  if ! tmux has-session -t "$target" 2>/dev/null; then
    die "La sesión '$target' no existe."
  fi
  tmux respawn-pane -k -t "$target"
  ok "Agente reiniciado en la sesión '$target'."
}

subcmd_logs() {
  local target=${1:-}
  local lines=${2:-80}
  [ -z "$target" ] && die "Uso: prama-agent logs <nombre_sesión> [líneas]"
  if ! tmux has-session -t "$target" 2>/dev/null; then
    die "La sesión '$target' no existe."
  fi
  refresh_dimensions
  printf '\n'
  box_top "◉ ULTIMAS $lines LINEAS // $target" "CAPTURE" "$C_BORDER_HI"
  tmux capture-pane -p -t "$target" -S "-${lines}"
  box_bottom "Reconectar: prama-agent attach $target" "$C_BORDER_HI"
  printf '\n'
}

subcmd_send() {
  local target=${1:-}
  shift || true
  local text="${*:-}"
  [ -n "$target" ] && [ -n "$text" ] || die "Uso: prama-agent send <nombre_sesión> \"<prompt o comando>\""
  if ! tmux has-session -t "$target" 2>/dev/null; then
    die "La sesión '$target' no existe."
  fi
  tmux send-keys -t "$target" -l "$text"
  tmux send-keys -t "$target" Enter
  ok "Mensaje enviado a '$target'."
}

subcmd_worktree() {
  local action=${1:-list}
  shift || true
  refresh_dimensions
  case "$action" in
    list|ls)
      printf '\n'
      box_top "⎇ GIT WORKTREES ACTIVOS" "ISOLATION" "$C_BORDER_HI"
      local i dir wt_line
      for i in "${!ZONES[@]}"; do
        dir=${ZONE_DIRS[$i]}
        if [ -d "$dir" ] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          box_row "$C_BORDER_HI" "${C_LIVE}▸ Zona: ${C_BOLD}${ZONES[$i]}${C_OFF} ($dir)"
          while IFS= read -r wt_line; do
            box_row "$C_BORDER_HI" "   $wt_line"
          done < <(git -C "$dir" worktree list)
        fi
      done
      box_bottom "Crear: prama-agent <agent> <zone> -w <rama>" "$C_BORDER_HI"
      printf '\n'
      ;;
    create|add)
      local zone=${1:-} name=${2:-}
      [ -n "$zone" ] && [ -n "$name" ] || die "Uso: prama-agent worktree create <zona> <nombre_rama>"
      local dir='' i
      for i in "${!ZONES[@]}"; do [ "${ZONES[$i]}" = "$zone" ] && dir=${ZONE_DIRS[$i]}; done
      [ -n "$dir" ] || die "Zona '$zone' no encontrada."
      local wt_path
      wt_path=$(provision_worktree "$dir" "$name")
      ok "Worktree listo en: $wt_path"
      ;;
    remove|rm)
      local zone=${1:-} name=${2:-}
      [ -n "$zone" ] && [ -n "$name" ] || die "Uso: prama-agent worktree remove <zona> <nombre_rama>"
      local dir='' i
      for i in "${!ZONES[@]}"; do [ "${ZONES[$i]}" = "$zone" ] && dir=${ZONE_DIRS[$i]}; done
      [ -n "$dir" ] || die "Zona '$zone' no encontrada."
      local wt_dir="$dir/worktrees/$name"
      git -C "$dir" worktree remove --force "$wt_dir" && ok "Worktree '$wt_dir' eliminado."
      ;;
    prune)
      local i dir
      for i in "${!ZONES[@]}"; do
        dir=${ZONE_DIRS[$i]}
        if [ -d "$dir" ] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
          git -C "$dir" worktree prune -v
          ok "Worktrees podados en ${ZONES[$i]} ($dir)"
        fi
      done
      ;;
    *)
      die "Subcomando worktree desconocido: '$action' (usa: list | create | remove | prune)"
      ;;
  esac
}

subcmd_profiles() {
  refresh_dimensions
  printf '\n'
  box_top "⚙ PERFILES DE ENRUTAMIENTO LLM (--profile / tecla [p])" "ROUTER" "$C_BORDER_HI"
  local phdr
  phdr=$(printf '%s%-17s %-15s %-36s %s%s' "$C_DIM" "PERFIL (--profile)" "ESTADO KEY" "ENDPOINT / GATEWAY" "MODELO OBJETIVO" "$C_OFF")
  box_row "$C_BORDER_HI" "$phdr"
  box_sep "$C_BORDER_HI"

  local row_str st_lbl st_col
  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "default" "$C_OFF" "$C_LIVE" "● Suscripcion" "$C_OFF" \
    "Nativo del CLI (Anthropic / Google)" "Claude Max / Agy Pro")
  box_row "$C_BORDER_HI" "$row_str"

  if [ -n "${KIMI_API_KEY:-}" ]; then st_lbl="● configurado"; st_col="$C_LIVE"; else st_lbl="○ falta key"; st_col="$C_BRASS"; fi
  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "kimi" "$C_OFF" "$st_col" "$st_lbl" "$C_OFF" \
    "${KIMI_BASE_URL:-https://api.moonshot.ai/anthropic}" "${KIMI_MODEL:-kimi-k2.7}")
  box_row "$C_BORDER_HI" "$row_str"

  if [ -n "${DEEPSEEK_API_KEY:-}" ]; then st_lbl="● configurado"; st_col="$C_LIVE"; else st_lbl="○ falta key"; st_col="$C_BRASS"; fi
  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "deepseek" "$C_OFF" "$st_col" "$st_lbl" "$C_OFF" \
    "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}" "${DEEPSEEK_MODEL:-deepseek-chat}")
  box_row "$C_BORDER_HI" "$row_str"

  if [ -n "${GLM_API_KEY:-}" ]; then st_lbl="● configurado"; st_col="$C_LIVE"; else st_lbl="○ falta key"; st_col="$C_BRASS"; fi
  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "glm" "$C_OFF" "$st_col" "$st_lbl" "$C_OFF" \
    "${GLM_BASE_URL:-https://open.bigmodel.cn/api/anthropic}" "${GLM_MODEL:-glm-4.6}")
  box_row "$C_BORDER_HI" "$row_str"

  if [ -n "${OPENROUTER_API_KEY:-}" ]; then st_lbl="● configurado"; st_col="$C_LIVE"; else st_lbl="○ falta key"; st_col="$C_BRASS"; fi
  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "openrouter" "$C_OFF" "$st_col" "$st_lbl" "$C_OFF" \
    "${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}" "${OPENROUTER_MAIN_MODEL:-anthropic/claude-sonnet-4}")
  box_row "$C_BORDER_HI" "$row_str"

  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "openrouter-free" "$C_OFF" "$st_col" "$st_lbl" "$C_OFF" \
    "${OPENROUTER_BASE_URL:-https://openrouter.ai/api/v1}" "${OPENROUTER_FREE_MODEL:-qwen/qwen3-coder:free}")
  box_row "$C_BORDER_HI" "$row_str"

  row_str=$(printf '%s%-17s%s %s%-15s%s %-36s %s' \
    "$C_BOLD" "local" "$C_OFF" "$C_NEON" "● proxy local" "$C_OFF" \
    "${LOCAL_ROUTER_URL:-http://127.0.0.1:3456}" "${LOCAL_ROUTER_MODEL:-default}")
  box_row "$C_BORDER_HI" "$row_str"

  box_bottom "Llaves en: /etc/prama-agent/providers.env" "$C_BORDER_HI"
  printf '\n'
}

subcmd_mcp() {
  refresh_dimensions
  printf '\n'
  box_top "☍ AUDITORIA DE SERVIDORES MCP" "MCP" "$C_BORDER_HI"
  local mline
  if command -v agy >/dev/null 2>&1; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ Agy MCP Servers:${C_OFF}"
    while IFS= read -r mline; do
      box_row "$C_BORDER_HI" "  $mline"
    done < <(agy mcp list 2>&1 || true)
  fi
  local i dir
  for i in "${!ZONES[@]}"; do
    dir=${ZONE_DIRS[$i]}
    if [ -f "$dir/.mcp.json" ]; then
      box_row "$C_BORDER_HI" "${C_LIVE}▸ Zona ${ZONES[$i]} ($dir/.mcp.json):${C_OFF}"
      while IFS= read -r mline; do
        box_row "$C_BORDER_HI" "  $mline"
      done < "$dir/.mcp.json"
    fi
  done
  if [ -f "$HOME/.claude.json" ]; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ Configuracion global Claude (~/.claude.json):${C_OFF} presente"
  fi
  box_bottom "MCP Audit Complete" "$C_BORDER_HI"
  printf '\n'
}

subcmd_doctor() {
  refresh_dimensions
  printf '\n'
  box_top "⚙ PRAMA AGENT // DOCTOR & SELF-HEALING" "DIAGNOSTICS" "$C_BORDER_HI"
  ensure_tmux_conf 1
  box_row "$C_BORDER_HI" "${C_LIVE}✔ OK:${C_OFF} ~/.tmux.conf actualizado (Botón táctil [⬅ MENU PRAMA] y atajo Ctrl+g activos)."

  if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>/dev/null; then
    local clients detached_count=0
    clients=$(tmux list-clients -F "#{client_name}|#{client_session}|#{client_activity}" 2>/dev/null || true)
    local now
    now=$(date +%s)
    while IFS='|' read -r c_tty c_sess c_act; do
      [ -z "$c_tty" ] && continue
      local idle=$(( now - ${c_act:-$now} ))
      if (( idle > 21600 )); then
        tmux detach-client -t "$c_tty" 2>/dev/null || true
        (( detached_count++ ))
        box_row "$C_BORDER_HI" "${C_BRASS}▲ AVISO:${C_OFF} Cliente tmux inactivo (${idle}s) desacoplado de '$c_sess' ($c_tty)"
      fi
    done <<< "$clients"
    if (( detached_count == 0 )); then
      box_row "$C_BORDER_HI" "${C_LIVE}✔ OK:${C_OFF} Sin clientes tmux zombis o colgados."
    fi
  fi

  local i dir
  for i in "${!ZONES[@]}"; do
    dir=${ZONE_DIRS[$i]}
    if [ -d "$dir" ] && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$dir" worktree prune 2>/dev/null || true
    fi
  done
  box_row "$C_BORDER_HI" "${C_LIVE}✔ OK:${C_OFF} Metadatos de Git worktrees verificados y saneados."

  for i in "${!AGENTS[@]}"; do
    if bin=$(command -v "${AGENTS[$i]}" 2>/dev/null); then
      box_row "$C_BORDER_HI" "${C_LIVE}✔ OK:${C_OFF} Agente '${AGENTS[$i]}' disponible en: $bin"
    else
      box_row "$C_BORDER_HI" "${C_BRASS}▲ AVISO:${C_OFF} Agente '${AGENTS[$i]}' no encontrado en PATH"
    fi
  done
  if bin_fzf=$(command -v fzf 2>/dev/null); then
    box_row "$C_BORDER_HI" "${C_LIVE}✔ OK:${C_OFF} Inspector Split-Screen fzf disponible en: $bin_fzf"
  fi
  box_bottom "Sistema optimizado" "$C_BORDER_HI"
  printf '\n'
}

info() {
  refresh_dimensions
  printf '\n'
  box_top "❖ GUIA RAPIDA: COMO VOLVER AL MENU, ENJAMBRE Y TELEGRAM" "AYUDA" "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}▸ 1. ¿COMO VOLVER AL MENU DESDE UNA VENTANA DE AGENTE?${C_OFF}"
  box_row "$C_BORDER_HI" "  • En Smartphone (Termius): ${C_NEON}${C_BOLD}Toca con el dedo el botón azul [⬅ MENU PRAMA]${C_OFF} abajo a la izq."
  box_row "$C_BORDER_HI" "  • Con el teclado: Presiona ${KEY_BADGE}Ctrl + g${C_OFF} o ${KEY_BADGE}Alt + b${C_OFF} (el agente sigue vivo en fondo)."
  box_row "$C_BORDER_HI" "  • Dentro de submenús: Elige ${C_BRASS}${C_BOLD}01 ▸ ⬅ VOLVER AL MENU${C_OFF} o presiona ${KEY_BADGE}0 / ← / ⌫ / b${C_OFF}."
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}▸ 2. ¿COMO HACER QUE LOS AGENTES SE HABLEN ENTRE ELLOS?${C_OFF}"
  box_row "$C_BORDER_HI" "  • En el Menú Principal, entra a ${C_BOLD}🤝 COORDINAR AGENTES${C_OFF} y elige ${C_LIVE}🚀 LANZAR DUPLA${C_OFF}."
  box_row "$C_BORDER_HI" "  • Eso inicia un Coordinador (Claude) y un Ejecutor (Agy) conectados por el Bus."
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}▸ 3. ¿COMO USARLO SI SE CIERRA TERMIUS EN EL CELULAR?${C_OFF}"
  box_row "$C_BORDER_HI" "  • En el Menú Principal, entra a ${C_BOLD}📱 CONTROL TELEGRAM${C_OFF} y vincula tu token de @BotFather."
  box_row "$C_BORDER_HI" "  • Podrás ver pantallas, lanzar agentes y chatear con ellos directo desde Telegram 24/7."
  box_bottom "Apache-2.0 · Prama Agent v$VERSION" "$C_BORDER_HI"
  printf '\n'
}

# Helper to launch an agent session from parameters and optionally attach or background
launch_configured_agent() {
  local l_agent=$1 l_zone=$2 l_role=$3 l_perm=$4 l_remote=$5 l_profile=$6 l_wt=$7 l_bg=$8 l_returnable=${9:-0}
  local l_dir='' idx_z
  for idx_z in "${!ZONES[@]}"; do
    [ "${ZONES[$idx_z]}" = "$l_zone" ] && l_dir=${ZONE_DIRS[$idx_z]}
  done
  [ -n "$l_dir" ] || die "La zona '$l_zone' no está registrada."
  command -v "$l_agent" >/dev/null 2>&1 || die "El agente '$l_agent' no está instalado."
  [ -d "$l_dir" ] || die "El directorio '$l_dir' no existe."

  local base_s s_name
  if [ "$l_role" = "executor" ]; then
    base_s="${PRAMA_SESSION_PREFIX}-${l_agent}-${l_zone}"
  else
    base_s="${PRAMA_SESSION_PREFIX}-${l_role}-${l_agent}-${l_zone}"
  fi

  if [ -n "$l_wt" ]; then
    local safe_wt
    safe_wt=$(echo "$l_wt" | tr '/: ' '---')
    s_name="${CUSTOM_NAME:-${base_s}-${safe_wt}}"
  else
    s_name="${CUSTOM_NAME:-$base_s}"
  fi

  ensure_tmux_conf

  local target_d="$l_dir"
  if [ -n "$l_wt" ]; then
    target_d=$(provision_worktree "$l_dir" "$l_wt")
  fi

  local role_prompt=""
  if [ "$l_role" != "executor" ]; then
    role_prompt=$(build_role_system_prompt "$l_role" "$s_name" "$l_zone")
  fi

  build_agent_command "$l_agent" "$l_perm" "$l_remote" "$s_name" "$role_prompt" "${PASS[@]}"
  apply_provider_profile "$l_profile"

  local tmux_env=(-e "IS_SANDBOX=1" -e "PATH=$PATH" -e "PRAMA_DAEMON_TASK=$DAEMON_TASK")
  local _ev
  for _ev in ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL \
             OPENAI_BASE_URL OPENAI_API_KEY OPENROUTER_MODEL XDG_CONFIG_HOME; do
    if [ -n "${!_ev:-}" ]; then
      tmux_env+=(-e "${_ev}=${!_ev}")
    fi
  done

  local r_args=("$SELF_PATH" "--internal-runner" "$s_name" "$target_d" "$l_profile" "$ONESHOT" "$l_role" "$DAEMON_INTERVAL" "--" "${CMD[@]}")
  local tmux_cmd_s
  printf -v tmux_cmd_s '%q ' "${r_args[@]}"
  tmux_cmd_s=${tmux_cmd_s% }

  if ! tmux has-session -t "$s_name" 2>/dev/null; then
    tmux new-session -d -s "$s_name" -c "$target_d" "${tmux_env[@]}" "$tmux_cmd_s"
  fi

  if (( l_bg )); then
    (( IS_TTY )) && printf '\e[?25h\n'
    box_top "✔ AGENTE LANZADO EN SEGUNDO PLANO" "$s_name" "$C_LIVE"
    box_row "$C_LIVE" "  ${C_MUTED}Sesion:${C_OFF}       ${C_BOLD}${s_name}${C_OFF}"
    box_row "$C_LIVE" "  ${C_MUTED}Rol:${C_OFF}          $(role_badge "$l_role")"
    box_row "$C_LIVE" "  ${C_MUTED}Permisos:${C_OFF}     ${l_perm^^} (Remote: $l_remote)"
    box_row "$C_LIVE" "  ${C_MUTED}Perfil LLM:${C_OFF}   $l_profile"
    box_row "$C_LIVE" "  ${C_MUTED}Directorio:${C_OFF}   $target_d"
    box_row "$C_LIVE" "  ${C_MUTED}Conectar:${C_OFF}     ${C_LIVE}prama-agent attach ${s_name}${C_OFF}"
    box_bottom "Ejecutandose en background persistente" "$C_LIVE"
    printf '\n'
  elif (( l_returnable )); then
    attach_session_returnable "$s_name"
  else
    (( IS_TTY )) && printf '\e[?25h\n'
    restore_locale
    attach_or_switch "$s_name"
  fi
}

# ── Early Dispatch for Internal Runner & Subcommands ────────────────────────
if [ "${1:-}" = "--internal-runner" ]; then
  shift
  internal_runner "$@"
  exit $?
fi

if [ $# -gt 0 ]; then
  case $1 in
    status|list|ls|ps)     subcmd_status; exit 0 ;;
    cockpit|lazy|ui)       shift; subcmd_cockpit "$@"; exit 0 ;;
    fzf|find)              launch_fzf_cockpit; exit 0 ;;
    bus|swarm)             shift; subcmd_bus "$@"; exit 0 ;;
    telegram|tg|bot)       shift; subcmd_telegram "$@"; exit 0 ;;
    attach|a)              shift; subcmd_attach "${1:-}"; exit 0 ;;
    stop|kill|k)           shift; subcmd_stop "${1:-}"; exit 0 ;;
    restart|r)             shift; subcmd_restart "${1:-}"; exit 0 ;;
    logs|peek|log)         shift; subcmd_logs "${1:-}" "${2:-80}"; exit 0 ;;
    send|inject)           shift; subcmd_send "$@"; exit 0 ;;
    worktree|worktrees|wt) shift; subcmd_worktree "$@"; exit 0 ;;
    profiles|providers)    subcmd_profiles; exit 0 ;;
    mcp)                   shift; subcmd_mcp "${1:-}"; exit 0 ;;
    doctor|fix)            subcmd_doctor; exit 0 ;;
    info|--info)           info; exit 0 ;;
    -h|--help|help)        usage; exit 0 ;;
    -v|--version)          printf 'prama-agent v%s\n' "$VERSION"; exit 0 ;;
  esac
fi

# ── Argument Parsing for Agent Launch ───────────────────────────────────────
AGENT='' ZONE='' DRY=0 BG=0 DIRECT=0 ONESHOT=0 PARALLEL=0
REMOTE="$PRAMA_DEFAULT_REMOTE"
ROLE="$PRAMA_DEFAULT_ROLE"
PERM_MODE="yolo"
(( PRAMA_SKIP_PERMISSIONS == 0 )) && PERM_MODE="ask"
DAEMON_INTERVAL=60
DAEMON_TASK=''
WORKTREE='' CUSTOM_NAME='' PROFILE='default'
PASS=()

while [ $# -gt 0 ]; do
  case $1 in
    -h|--help)          usage; exit 0 ;;
    info|--info)        info; exit 0 ;;
    --dry-run)          DRY=1; shift ;;
    --bg|-d|--detach)   BG=1; shift ;;
    --direct|--no-tmux) DIRECT=1; shift ;;
    --oneshot)          ONESHOT=1; shift ;;
    --parallel)         PARALLEL=1; shift ;;
    --remote|-R)        REMOTE=1; shift ;;
    --no-remote)        REMOTE=0; shift ;;
    --safe|--ask)       PERM_MODE="ask"; shift ;;
    --yolo)             PERM_MODE="yolo"; shift ;;
    --plan|--readonly)  PERM_MODE="plan"; ROLE="reader"; shift ;;
    --perm)
      [ $# -ge 2 ] || die "--perm requiere yolo | plan | ask"
      PERM_MODE=$2; shift 2 ;;
    --role|-O)
      [ $# -ge 2 ] || die "--role requiere executor | coordinator | reader | daemon"
      ROLE=$2
      [ "$ROLE" = "reader" ] && PERM_MODE="plan"
      shift 2 ;;
    --loop)
      [ $# -ge 2 ] || die "--loop requiere segundos (ej. 60)"
      DAEMON_INTERVAL=$2; ROLE="daemon"; shift 2 ;;
    --task)
      [ $# -ge 2 ] || die "--task requiere una instrucción"
      DAEMON_TASK=$2; shift 2 ;;
    --name|-n)
      [ $# -ge 2 ] || die "--name requiere un nombre de sesión"
      CUSTOM_NAME=$2; shift 2 ;;
    --worktree|-w)
      [ $# -ge 2 ] || die "--worktree requiere un nombre de rama"
      WORKTREE=$2; shift 2 ;;
    --profile|-P)
      [ $# -ge 2 ] || die "--profile requiere el nombre del perfil"
      PROFILE=$2; shift 2 ;;
    --Zone|--zone|-z)
      [ $# -ge 2 ] || die "--zone requiere el nombre de la zona"
      ZONE=$2; shift 2 ;;
    --)
      shift; PASS+=("$@"); break ;;
    back|b) [ -z "$ZONE" ] && is_in "backend" "${ZONES[@]}" && ZONE="backend" || PASS+=("$1"); shift ;;
    land|l) [ -z "$ZONE" ] && is_in "landing" "${ZONES[@]}" && ZONE="landing" || PASS+=("$1"); shift ;;
    mon|m)  [ -z "$ZONE" ] && is_in "monitoring" "${ZONES[@]}" && ZONE="monitoring" || PASS+=("$1"); shift ;;
    *)
      if [ -z "$AGENT" ] && is_in "$1" "${AGENTS[@]}"; then AGENT=$1
      elif [ -z "$ZONE" ] && is_in "$1" "${ZONES[@]}"; then ZONE=$1
      elif is_in "$1" "${AVAILABLE_ROLES[@]}"; then
        ROLE=$1
        [ "$ROLE" = "reader" ] && PERM_MODE="plan"
      else PASS+=("$1"); fi
      shift ;;
  esac
done

# ── Live Metadata Builders ──────────────────────────────────────────────────
AGENT_METAS=() AGENT_AVAIL=()
for i in "${!AGENTS[@]}"; do
  if bin=$(command -v "${AGENTS[$i]}" 2>/dev/null); then
    AGENT_METAS+=("${AGENT_DESCS[$i]} · $bin")
    AGENT_AVAIL+=(1)
  else
    AGENT_METAS+=("${AGENT_DESCS[$i]} · [no instalado]")
    AGENT_AVAIL+=(0)
  fi
done

ZONE_METAS=() ZONE_AVAIL=()
for i in "${!ZONES[@]}"; do
  dir=${ZONE_DIRS[$i]}
  if [ -d "$dir" ]; then
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '—')
    dirty=''
    [ -n "$(git -C "$dir" status --porcelain 2>/dev/null | head -1)" ] && dirty=' ●'
    ZONE_METAS+=("${ZONE_DESCS[$i]} · $dir (⎇ $branch$dirty)")
    ZONE_AVAIL+=(1)
  else
    ZONE_METAS+=("${ZONE_DESCS[$i]} · $dir [no existe]")
    ZONE_AVAIL+=(0)
  fi
done

# ── Interactive TUI Loop (Always Returns to Main Menu After Detaching!) ─────
if [ -z "$AGENT" ] || [ -z "$ZONE" ]; then
  ensure_tmux_conf
  if (( IS_TTY )); then
    IN_TUI=1
    tui_enter_screen
    trap 'tui_leave_screen' EXIT
  fi

  TUI_STATE="hub"
  if [ -n "$AGENT" ] && [ -z "$ZONE" ]; then
    TUI_STATE="zone"
  fi

  while true; do
    refresh_dimensions
    case "$TUI_STATE" in
      hub)
        sync_bus_state
        ACTIVE_PANES=""
        if command -v tmux >/dev/null 2>&1; then
          ACTIVE_PANES=$(tmux list-panes -a -F "#{session_name}|#{pane_pid}|#{pane_current_path}|#{pane_dead}|#{session_attached}|#{pane_current_command}" 2>/dev/null || true)
        fi

        HUB_LABELS=() HUB_METAS=() HUB_AVAIL=() HUB_TARGETS=()
        if [ -n "$ACTIVE_PANES" ]; then
          while IFS='|' read -r s_name p_pid p_path p_dead s_att p_cmd; do
            [ -z "$s_name" ] && continue
            [[ "$s_name" == *-telegram-bot* ]] && continue
            a_pid=$(resolve_pane_agent_pid "$p_pid")
            IFS='|' read -r cpu mem _etime comm <<< "$(get_proc_metrics "$a_pid")"
            IFS='|' read -r st_lbl _st_col <<< "$(detect_pane_activity_state "$s_name" "$p_dead" "$comm")"
            gauge=$(draw_gauge "$cpu" 4)
            s_role="executor"
            [ -f "$PRAMA_BUS_DIR/state/${s_name}.env" ] && s_role=$(grep '^ROLE=' "$PRAMA_BUS_DIR/state/${s_name}.env" | cut -d'"' -f2 || echo "executor")
            HUB_LABELS+=("◉ ENTRAR")
            if (( IS_COMPACT )); then
              HUB_METAS+=("$s_name [$st_lbl]")
            else
              HUB_METAS+=("$s_name [$(role_badge "$s_role") · $st_lbl] $gauge ${cpu}% · $mem")
            fi
            HUB_AVAIL+=(1)
            HUB_TARGETS+=("$s_name")
          done <<< "$ACTIVE_PANES"
        fi

        HUB_LABELS+=(
          "✚ NUEVO AGENTE"
          "❖ COORDINAR"
          "☍ TELEGRAM 24/7"
          "⚙ DOCTOR / FIX"
        )
        if (( IS_COMPACT )); then
          HUB_METAS+=(
            "Elegir Claude, Agy, Kimi ($ROLE)"
            "Agentes que se hablan entre sí"
            "Controlar desde app Telegram"
            "Limpiar SSH y optimizar tmux"
          )
        else
          HUB_METAS+=(
            "Lanzar un agente CLI (Claude, Agy, Kimi, Gemini, Qwen) en una zona"
            "Enjambre Multi-Agente: Lanzar Coordinador+Ejecutor, Cockpit o enviar tarea"
            "Vincular Bot de Telegram 24/7 (úsalo aunque se cierre Termius)"
            "Sanear sesiones SSH colgadas, actualizar botón táctil y limpiar worktrees"
          )
        fi
        HUB_AVAIL+=(1 1 1 1)
        HUB_TARGETS+=("" "" "" "")

        rc=0
        tui_select_box "hub" "⌂ MENU PRINCIPAL · PRAMA AGENT" HUB_LABELS HUB_METAS HUB_AVAIL HUB_TARGETS || rc=$?
        if (( rc == 3 )) || (( rc == 2 )); then
          continue
        fi

        if (( CHOICE == -10 )); then
          TUI_STATE="agent"
          continue
        fi

        if [ -n "${HUB_TARGETS[$CHOICE]:-}" ]; then
          attach_session_returnable "${HUB_TARGETS[$CHOICE]}"
          continue
        elif [ "${HUB_LABELS[$CHOICE]}" = "✚ NUEVO AGENTE" ]; then
          AGENT=""
          ZONE=""
          TUI_STATE="agent"
        elif [ "${HUB_LABELS[$CHOICE]}" = "❖ COORDINAR" ]; then
          swarm_wizard_menu
          continue
        elif [ "${HUB_LABELS[$CHOICE]}" = "☍ TELEGRAM 24/7" ]; then
          subcmd_telegram menu
          continue
        elif [ "${HUB_LABELS[$CHOICE]}" = "⚙ DOCTOR / FIX" ]; then
          printf '\e[2J\e[H'
          subcmd_doctor
          printf ' Presiona cualquier tecla para volver al menú...'
          IFS= read -rsn1 _ || true
          continue
        fi
        ;;

      agent)
        STEP1_LABELS=("◄ VOLVER AL MENU" "${AGENTS[@]}")
        STEP1_METAS=("Regresar al Menú Principal de Prama Agent" "${AGENT_METAS[@]}")
        STEP1_AVAIL=(1 "${AGENT_AVAIL[@]}")
        DUMMY_TARGETS=()
        rc=0
        tui_select_box "agent" "✦ PASO 1/2 · ELIGE EL AGENTE (Rol: $ROLE)" STEP1_LABELS STEP1_METAS STEP1_AVAIL DUMMY_TARGETS || rc=$?
        if (( rc == 3 )); then
          continue
        elif (( rc == 2 )) || (( CHOICE == 0 )); then
          TUI_STATE="hub"
          continue
        fi
        AGENT=${AGENTS[$((CHOICE - 1))]}
        TUI_STATE="zone"
        ;;

      zone)
        STEP2_LABELS=("◄ VOLVER ATRAS" "${ZONES[@]}")
        STEP2_METAS=("Regresar a la selección de Agente" "${ZONE_METAS[@]}")
        STEP2_AVAIL=(1 "${ZONE_AVAIL[@]}")
        DUMMY_TARGETS=()
        rc=0
        tui_select_box "zone" "⟐ PASO 2/2 · ELIGE ZONA (${AGENT^^} · Rol: $ROLE)" STEP2_LABELS STEP2_METAS STEP2_AVAIL DUMMY_TARGETS || rc=$?
        if (( rc == 3 )); then
          continue
        elif (( rc == 2 )) || (( CHOICE == 0 )); then
          ZONE=""
          AGENT=""
          TUI_STATE="agent"
          continue
        fi
        ZONE=${ZONES[$((CHOICE - 1))]}
        launch_configured_agent "$AGENT" "$ZONE" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$WORKTREE" "$BG" 1
        AGENT=""
        ZONE=""
        TUI_STATE="hub"
        continue
        ;;
    esac
  done
fi

# ── Direct CLI Execution Mode (when both AGENT and ZONE were passed on CLI) ─
DIR=''
for i in "${!ZONES[@]}"; do
  [ "${ZONES[$i]}" = "$ZONE" ] && DIR=${ZONE_DIRS[$i]}
done
[ -n "$DIR" ] || die "La zona '$ZONE' no está registrada en el catálogo."
command -v "$AGENT" >/dev/null 2>&1 || die "El agente '$AGENT' no está instalado en PATH."
[ -d "$DIR" ] || die "El directorio '$DIR' de la zona '$ZONE' no existe."

if [ "$ROLE" = "executor" ]; then
  BASE_SESSION="${PRAMA_SESSION_PREFIX}-${AGENT}-${ZONE}"
else
  BASE_SESSION="${PRAMA_SESSION_PREFIX}-${ROLE}-${AGENT}-${ZONE}"
fi

if [ -n "$WORKTREE" ]; then
  SAFE_WT=$(echo "$WORKTREE" | tr '/: ' '---')
  SESSION_NAME="${CUSTOM_NAME:-${BASE_SESSION}-${SAFE_WT}}"
else
  SESSION_NAME="${CUSTOM_NAME:-$BASE_SESSION}"
fi

ensure_tmux_conf

if (( ! DRY )) && (( ! DIRECT )) && [ -z "$CUSTOM_NAME" ] && [ -z "$WORKTREE" ]; then
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    if (( PARALLEL )) || (( BG )); then
      n=2
      while tmux has-session -t "${SESSION_NAME}-${n}" 2>/dev/null; do (( n++ )); done
      SESSION_NAME="${SESSION_NAME}-${n}"
    else
      restore_locale
      attach_or_switch "$SESSION_NAME"
    fi
  fi
fi

TARGET_DIR="$DIR"
if [ -n "$WORKTREE" ]; then
  if (( DRY )); then
    TARGET_DIR="$DIR/worktrees/$WORKTREE"
  else
    TARGET_DIR=$(provision_worktree "$DIR" "$WORKTREE")
    ok "Worktree aislado activo en: $TARGET_DIR"
  fi
fi

ROLE_SYS_PROMPT=""
if [ "$ROLE" != "executor" ]; then
  ROLE_SYS_PROMPT=$(build_role_system_prompt "$ROLE" "$SESSION_NAME" "$ZONE")
fi

build_agent_command "$AGENT" "$PERM_MODE" "$REMOTE" "$SESSION_NAME" "$ROLE_SYS_PROMPT" "${PASS[@]}"

if (( DRY )); then
  ESCAPED_CMD=$(printf '%q ' "${CMD[@]}")
  printf 'cd %q && IS_SANDBOX=1 ROLE=%q PERM=%q REMOTE=%q PROFILE=%q tmux new-session -s %q -c %q -- %s\n' \
    "$TARGET_DIR" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$SESSION_NAME" "$TARGET_DIR" "${ESCAPED_CMD% }"
  exit 0
fi

apply_provider_profile "$PROFILE"

if (( DIRECT )); then
  (( IS_TTY )) && printf '\e[?25h\n'
  cd "$TARGET_DIR" || die "No se pudo entrar a $TARGET_DIR"
  export IS_SANDBOX=1
  export PRAMA_SESSION="$SESSION_NAME"
  export PRAMA_ROLE="$ROLE"
  restore_locale
  exec "${CMD[@]}"
fi

CUSTOM_NAME="$SESSION_NAME"
launch_configured_agent "$AGENT" "$ZONE" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$WORKTREE" "$BG" 0
