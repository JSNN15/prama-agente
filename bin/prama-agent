#!/usr/bin/env bash
# prama-agent — Multi-agent terminal control plane for CLI coding agents
# Copyright 2026 Contributors
# Licensed under the Apache License, Version 2.0 (http://www.apache.org/licenses/LICENSE-2.0)

set -u

VERSION="6.0.0"

# Status line fast path: agy redraws it several times per second, so the last line is reused
# for PRAMA_SL_MIN seconds with bash builtins only (no forks, before anything else runs).
if [ "${1:-}" = "--internal-statusline" ] && [ -n "${PRAMA_SL_CACHE:-}" ] \
   && { IFS= read -r _ts && IFS= read -r _line; } < "$PRAMA_SL_CACHE" 2>/dev/null \
   && [[ "$_ts" =~ ^[0-9]+$ ]] && printf -v _now '%(%s)T' -1 && (( _now - _ts < ${PRAMA_SL_MIN:-10} )); then
  read -r -d '' _ || true
  printf '%s\n' "$_line"
  exit 0
fi
# Hooks fired outside prama panes (agy's hooks are global): answer "no decision" and leave.
if [ "${1:-}" = "--internal-hook" ] && [ -z "${PRAMA_SESSION:-}" ]; then
  [ "${2:-}" = agy ] && printf '{}\n'
  read -r -d '' _ || true
  exit 0
fi

SELF_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
REPO_ROOT="$(cd "$(dirname "$SELF_PATH")/.." && pwd)"
LIB_DIR="$REPO_ROOT/lib"
export SELF_PATH LIB_DIR VERSION

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "prama-agent requiere bash >= 4.4 (tienes $BASH_VERSION)" >&2
  exit 1
fi

case "${1:-}" in
  -v|--version|version) printf 'prama-agent v%s\n' "$VERSION"; exit 0 ;;
esac

for _p in "$HOME/.local/bin" "$HOME/.opencode/bin" "/usr/local/bin"; do
  [ -d "$_p" ] && [[ ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
export PATH

case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
  *[Uu][Tt][Ff]*8*) ;;
  *) export LC_ALL=C.UTF-8 ;;
esac

# Hook fast path: called by the agent CLI on every lifecycle event; must be quick and silent.
# agy expects a JSON object on stdout ("{}" = no decision).
if [ "${1:-}" = "--internal-hook" ]; then
  [ "${2:-}" = agy ] && printf '{}\n'
  # shellcheck source=/dev/null
  # PRAMA_HOOK_DEBUG=<file> collects errors while diagnosing a CLI's hook integration.
  { source "$LIB_DIR/core.sh" && source "$LIB_DIR/health.sh" && prama_init && hook_ingest "${2:-}" "${3:-}"; } \
    >/dev/null 2>>"${PRAMA_HOOK_DEBUG:-/dev/null}"
  exit 0
fi

# Status line (cache miss): parse the payload, update the quota file, print the line.
if [ "${1:-}" = "--internal-statusline" ]; then
  # shellcheck source=/dev/null
  { source "$LIB_DIR/core.sh" && source "$LIB_DIR/health.sh" && prama_init >/dev/null && statusline_ingest "${2:-}"; } \
    2>>"${PRAMA_HOOK_DEBUG:-/dev/null}"
  exit 0
fi

for _m in core ui agents roles bus health fleet telegram tui; do
  # shellcheck source=/dev/null
  source "$LIB_DIR/$_m.sh"
done

prama_init
command -v tmux >/dev/null 2>&1 || die "tmux no está instalado (sudo apt install tmux)."

# ── Small helpers ───────────────────────────────────────────────────────────
pause_key() {
  (( IS_TTY )) || return 0
  printf '\n %s%s Presiona una tecla para volver %s' "$KEY_BADGE" " ↵ " "$C_OFF"
  IFS= read -rsn1 _ || true
}

# Resolves an exact (or unique-prefix) match from a list; prints it or returns 1.
match_one() {
  local needle=$1; shift
  local e hits=()
  is_in "$needle" "$@" && { printf '%s' "$needle"; return 0; }
  for e in "$@"; do [[ "$e" == "$needle"* ]] && hits+=("$e"); done
  (( ${#hits[@]} == 1 )) && { printf '%s' "${hits[0]}"; return 0; }
  return 1
}

require_session() {
  local s=${1:-}
  [ -n "$s" ] || die "Falta el nombre de la sesión. Mira las activas con: prama-agent status"
  tmx_has "$s" || die "La sesión '$s' no existe en el servidor prama. Activas: $(prama_sessions | tr '\n' ' ')"
}

# ── Subcommands ─────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
${C_BOLD}prama-agent v$VERSION${C_OFF} — control plane para agentes de código en terminal

${C_BOLD}USO${C_OFF}
  prama-agent                          Abre la interfaz interactiva
  prama-agent <agente> <zona> [opc.] [-- args del agente]
  prama-agent <subcomando> [args]

${C_BOLD}LANZAR${C_OFF}  agentes: ${AGENTS[*]}  ·  zonas: ${ZONES[*]}
  --role, -O <rol>       executor | coordinator | reader | daemon
  --ask | --plan | --yolo  permisos (por defecto: $( (( PRAMA_SKIP_PERMISSIONS )) && echo yolo || echo ask ))
  --remote | --no-remote   Remote Control nativo (claude/agy)
  --model, -m <modelo>   claude: opus|sonnet|haiku…  agy: prama-agent fleet models agy
  --effort <nivel>       low | medium | high | xhigh | max (claude)
  --preset <nombre>      perfil con skills/plugins/prompt (prama-agent fleet presets)
  --profile, -P <perfil> ${AVAILABLE_PROFILES[*]} (endpoints para claude)
  --worktree, -w <rama>  aislar en un git worktree (fuera del repo)
  --name, -n <sesión>    nombre de sesión personalizado
  --bg, -d               lanzar en segundo plano   --porcelain  imprime solo el nombre
  --parallel             otra instancia si ya existe
  --loop <seg> --task "<t>"  daemon con tarea recurrente   --oneshot  una sola ejecución
  --direct               sin tmux (exec directo)   --dry-run  muestra el comando

${C_BOLD}SESIONES${C_OFF}
  status | ls            Panel de la flota             sessions --json   Listado para scripts
  attach | a [sesión]    Conectar (Ctrl+b d o $PRAMA_MENU_KEY para salir)
  logs <sesión> [N]      Últimas N líneas              capture <sesión> [N]  Texto plano
  send <sesión> "<txt>"  Escribir en el agente         restart <sesión>  Relanzar
  stop <sesión> | stop --all [-y]

${C_BOLD}FLOTA${C_OFF}  (lo que usa el coordinador para administrar agentes)
  fleet status [--json]  Estado, bloqueos (login/cuota/crédito/modelo) y modelo de cada agente
  fleet spawn <agente> <zona> [--model M] [--preset P] [--task "…"]   Lanzar un agente extra
  fleet model <sesión> <modelo>   fleet edit <sesión> …   fleet restart|kill <sesión>
  fleet presets | models [agente] | watchdog [status|start|stop|logs] | hooks [status|install|uninstall]

${C_BOLD}ENJAMBRE${C_OFF}
  bus status|assign|report|inbox|broadcast|watch|swarm-start|clear|help
  cockpit [zona] [coord] [exec]   Pantalla dividida coordinador + ejecutor + bus
  fzf                    Inspector con vista previa

${C_BOLD}SISTEMA${C_OFF}
  worktree list|create|remove|prune   profiles   mcp   zones|agents [--json]
  telegram setup|start|stop|restart|status|logs|test|notify   doctor [--restore-tmux-conf]
  completion bash        Autocompletado           info  Guía rápida
EOF
}

subcmd_info() {
  refresh_dimensions
  printf '\n'
  box_top "❖ GUIA RAPIDA" "v$VERSION" "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}Volver al menú desde un agente${C_OFF}"
  box_row "$C_BORDER_HI" "  Toca ${C_NEON}◂ MENU${C_OFF} en la barra inferior, o pulsa ${KEY_BADGE} $PRAMA_MENU_KEY ${C_OFF} / ${KEY_BADGE} Ctrl+b d ${C_OFF}."
  box_row "$C_BORDER_HI" "  El agente sigue vivo en segundo plano."
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}Agentes que colaboran${C_OFF}"
  box_row "$C_BORDER_HI" "  Coordinar enjambre → Lanzar dupla: un coordinador y un ejecutor"
  box_row "$C_BORDER_HI" "  que se hablan con ${C_NEON}prama-agent bus assign / report${C_OFF}."
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}Desde el celular sin SSH${C_OFF}"
  box_row "$C_BORDER_HI" "  ${C_NEON}prama-agent telegram setup${C_OFF}: vincula un bot con un código de un solo uso."
  box_sep "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "${C_LIVE}${C_BOLD}Permisos${C_OFF}"
  box_row "$C_BORDER_HI" "  $(perm_badge ask)  ·  $(perm_badge plan)  ·  $(perm_badge yolo)"
  box_row "$C_BORDER_HI" "  YOLO solo en servidores aislados: el agente ejecuta sin preguntar."
  box_bottom "Apache-2.0" "$C_BORDER_HI"
  printf '\n'
}

# Collects one line per session: name|pane_pid|cmd|path|dead|attached
list_panes_raw() {
  tmx list-panes -a -F '#{session_name}|#{pane_pid}|#{pane_current_command}|#{pane_current_path}|#{pane_dead}|#{session_attached}' 2>/dev/null \
    | awk -F'|' '!seen[$1]++'
}

subcmd_status() {
  refresh_dimensions
  state_gc
  printf '\n'
  box_top "✦ $PRAMA_BRAND · FLOTA" "$(host_stats_label)" "$C_BORDER_HI"
  local panes count=0
  panes=$(list_panes_raw)
  if [ -z "$panes" ]; then
    box_row "$C_BORDER_HI" "${C_MUTED}No hay agentes en ejecución.${C_OFF}"
    box_row "$C_BORDER_HI" "Lanza uno con ${C_NEON}prama-agent${C_OFF} (interfaz) o ${C_NEON}prama-agent claude <zona>${C_OFF}."
  else
    box_row "$C_BORDER_HI" "$(printf '%s%-28s %-15s %-11s %-6s %-7s %s%s' "$C_MUTED" SESION ROL ESTADO CPU RAM "ZONA / RAMA" "$C_OFF")"
    box_sep "$C_BORDER_HI"
    local s ppid pcmd ppath dead _att a_pid cpu mem _et comm st branch
    while IFS='|' read -r s ppid pcmd ppath dead _att; do
      [ -z "$s" ] && continue
      (( count++ ))
      a_pid=$(resolve_pane_agent_pid "$ppid")
      IFS='|' read -r cpu mem _et comm <<< "$(get_proc_metrics "$a_pid")"
      st=$(detect_session_state "$s" "$dead" "$pcmd")
      branch=$(git -C "$ppath" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
      box_row "$C_BORDER_HI" "$(printf '%s%-28s%s %-15s %s %-5s %-7s %s' \
        "$C_BOLD" "$(truncate_cols "$s" 28)" "$C_OFF" "$(role_badge "$(session_role "$s")")" \
        "$(state_badge "$st")$(repeat_char ' ' $(( 9 - ${#st} )))" "${cpu%.*}%" "$mem" \
        "$(basename "$ppath")${branch:+ ⎇ $branch}")"
    done <<< "$panes"
  fi
  box_bottom "$count sesiones · attach <s> · logs <s> · stop <s>" "$C_BORDER_HI"

  local unmanaged
  unmanaged=$(find_unmanaged_agents)
  if [ -n "$unmanaged" ]; then
    printf '\n'
    box_top "▲ AGENTES FUERA DE PRAMA (se pierden si se corta SSH)" "" "$C_BRASS"
    local u_pid u_tty u_comm u_cpu u_mem u_et u_cwd
    while IFS='|' read -r u_pid u_tty u_comm u_cpu u_mem u_et u_cwd; do
      box_row "$C_BRASS" "$(printf '%-8s %-8s %-7s %-6s %-7s %s' "$u_pid" "$u_comm" "$u_tty" "$u_cpu" "$u_mem" "$u_cwd")"
    done <<< "$unmanaged"
    box_bottom "Lánzalos con prama-agent para que sobrevivan" "$C_BRASS"
  fi
  printf '\n'
}

subcmd_sessions() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local panes s ppid pcmd ppath dead att a_pid cpu mem _et comm first=1 internal
  panes=$(list_panes_raw)
  (( json )) && printf '['
  while IFS='|' read -r s ppid pcmd ppath dead att; do
    [ -z "$s" ] && continue
    if (( ! json )); then printf '%s\n' "$s"; continue; fi
    a_pid=$(resolve_pane_agent_pid "$ppid")
    IFS='|' read -r cpu mem _et comm <<< "$(get_proc_metrics "$a_pid")"
    internal=false; is_internal_session "$s" && internal=true
    (( first )) || printf ','
    first=0
    printf '{"name":"%s","role":"%s","state":"%s","agent":"%s","zone":"%s","cpu":"%s","mem":"%s","dir":"%s","attached":%s,"internal":%s}' \
      "$(json_escape "$s")" "$(session_role "$s")" "$(detect_session_state "$s" "$dead" "$pcmd")" \
      "$(json_escape "$(state_get "$s" AGENT "$comm")")" "$(json_escape "$(state_get "$s" ZONE)")" \
      "$cpu" "$mem" "$(json_escape "$ppath")" "$( (( att > 0 )) && echo true || echo false)" "$internal"
  done <<< "$panes"
  (( json )) && printf ']\n'
  return 0
}

subcmd_zones() {
  local i
  if [ "${1:-}" = "--json" ]; then
    printf '['
    for i in "${!ZONES[@]}"; do
      (( i )) && printf ','
      printf '{"name":"%s","dir":"%s","exists":%s}' "$(json_escape "${ZONES[$i]}")" "$(json_escape "${ZONE_DIRS[$i]}")" \
        "$([ -d "${ZONE_DIRS[$i]}" ] && echo true || echo false)"
    done
    printf ']\n'
  else
    for i in "${!ZONES[@]}"; do printf '%-16s %s\n' "${ZONES[$i]}" "${ZONE_DIRS[$i]}"; done
  fi
}

subcmd_agents() {
  local i
  if [ "${1:-}" = "--json" ]; then
    printf '['
    for i in "${!AGENTS[@]}"; do
      (( i )) && printf ','
      printf '{"name":"%s","installed":%s}' "${AGENTS[$i]}" "$(agent_installed "${AGENTS[$i]}" && echo true || echo false)"
    done
    printf ']\n'
  else
    for i in "${!AGENTS[@]}"; do
      printf '%-8s %s\n' "${AGENTS[$i]}" "$(command -v "${AGENTS[$i]}" 2>/dev/null || echo '(no instalado)')"
    done
  fi
}

subcmd_attach() {
  local target=${1:-}
  ensure_tmux_conf
  if [ -z "$target" ]; then
    mapfile -t _ss < <(prama_sessions)
    case ${#_ss[@]} in
      0) die "No hay sesiones activas. Abre la interfaz con 'prama-agent' para lanzar una." ;;
      1) target=${_ss[0]} ;;
      *)
        if command -v fzf >/dev/null 2>&1 && (( IS_TTY )); then
          target=$(printf '%s\n' "${_ss[@]}" | fzf --height=40% --border=rounded --prompt='sesión › ') || exit 0
        else
          PS3="Sesión: "
          select target in "${_ss[@]}"; do [ -n "$target" ] && break; done
        fi ;;
    esac
  fi
  require_session "$target"
  tmx_attach "$target" 1
}

subcmd_stop() {
  local target=${1:-} yes=0
  [ "${2:-}" = "-y" ] || [ "${2:-}" = "--yes" ] && yes=1
  [ -n "$target" ] || die "Uso: prama-agent stop <sesión> | stop --all [-y]"
  if [ "$target" = "--all" ]; then
    mapfile -t _ss < <(prama_sessions)
    (( ${#_ss[@]} )) || { info_msg "No hay sesiones de agentes activas."; return 0; }
    if (( ! yes )); then
      (( IS_TTY )) || die "Sin terminal interactiva: usa 'stop --all -y' para confirmar."
      printf ' Se cerrarán %d sesiones: %s\n ¿Continuar? [s/N] ' "${#_ss[@]}" "${_ss[*]}"
      local a; IFS= read -r a
      [[ "$a" =~ ^[sSyY]$ ]] || { info_msg "Cancelado."; return 0; }
    fi
    local s
    for s in "${_ss[@]}"; do
      tmx_kill "$s" && state_remove "$s" && bus_event stopped operator "$s" "" && ok "Sesión '$s' cerrada."
    done
    return 0
  fi
  require_session "$target"
  tmx_kill "$target"
  state_remove "$target"
  bus_event stopped operator "$target" ""
  ok "Sesión '$target' cerrada."
}

subcmd_restart() {
  require_session "${1:-}"
  tmx respawn-pane -k -t "=$1:" && ok "Agente relanzado en '$1' (el historial se conserva)."
}

subcmd_logs() {
  local target=${1:-} lines=${2:-80}
  require_session "$target"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "N debe ser un número."
  refresh_dimensions
  if (( IS_TTY )) && command -v less >/dev/null 2>&1 && (( lines > ${ROWS:-24} )); then
    tmx_capture "$target" "$lines" 1 | less -R +G
  else
    box_top "◉ $target" "últimas $lines líneas" "$C_BORDER_HI"
    tmx_capture "$target" "$lines" "$IS_TTY"
    box_bottom "prama-agent attach $target" "$C_BORDER_HI"
  fi
}

subcmd_capture() {
  local lines=${2:-40}
  require_session "${1:-}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "N debe ser un número."
  tmx_capture "$1" "$lines" 0
}

subcmd_send() {
  local target=${1:-}
  shift || true
  local text="$*"
  [ -n "$target" ] && [ -n "$text" ] || die "Uso: prama-agent send <sesión> \"<texto>\""
  require_session "$target"
  tmx_send "$target" "$text" && ok "Enviado a '$target'."
}

subcmd_worktree() {
  local action=${1:-list}
  shift || true
  refresh_dimensions
  case "$action" in
    list|ls)
      box_top "⎇ GIT WORKTREES" "" "$C_BORDER_HI"
      local i dir line
      for i in "${!ZONES[@]}"; do
        dir=${ZONE_DIRS[$i]}
        git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
        box_row "$C_BORDER_HI" "${C_LIVE}▸ ${C_BOLD}${ZONES[$i]}${C_OFF} ${C_MUTED}$dir${C_OFF}"
        while IFS= read -r line; do box_row "$C_BORDER_HI" "   $line"; done < <(git -C "$dir" worktree list)
      done
      box_bottom "crear: prama-agent worktree create <zona> <rama>" "$C_BORDER_HI" ;;
    create|add)
      local zone=${1:-} branch=${2:-} dir wt
      [ -n "$zone" ] && [ -n "$branch" ] || die "Uso: prama-agent worktree create <zona> <rama>"
      dir=$(zone_dir "$zone") || die "Zona '$zone' no encontrada."
      wt=$(provision_worktree "$dir" "$branch") || exit 1
      ok "Worktree listo en: $wt" ;;
    remove|rm)
      local zone=${1:-} branch=${2:-} dir wt
      [ -n "$zone" ] && [ -n "$branch" ] || die "Uso: prama-agent worktree remove <zona> <rama>"
      dir=$(zone_dir "$zone") || die "Zona '$zone' no encontrada."
      wt=$(worktree_path "$dir" "$branch")
      [ -d "$wt" ] || die "No existe el worktree $wt"
      git -C "$dir" worktree remove "$wt" \
        || die "Git rechazó borrar $wt (¿cambios sin guardar?). Revisa y usa: git -C $dir worktree remove --force $wt"
      ok "Worktree eliminado: $wt (la rama '$branch' se conserva)" ;;
    prune)
      local i
      for i in "${!ZONES[@]}"; do
        git -C "${ZONE_DIRS[$i]}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || continue
        git -C "${ZONE_DIRS[$i]}" worktree prune -v && ok "Podado: ${ZONES[$i]}"
      done ;;
    *) die "Acción desconocida: '$action' (list | create | remove | prune)" ;;
  esac
}

subcmd_profiles() {
  refresh_dimensions
  box_top "⚙ PERFILES LLM" "--profile" "$C_BORDER_HI"
  box_row "$C_BORDER_HI" "$(printf '%s%-16s %-14s %-38s %s%s' "$C_MUTED" PERFIL ESTADO ENDPOINT MODELO "$C_OFF")"
  box_sep "$C_BORDER_HI"
  _prof_row() {
    local name=$1 key=$2 url=$3 model=$4 st
    if [ "$key" = native ]; then st="${C_LIVE}● nativo${C_OFF}      "
    elif [ "$key" = local ]; then st="${C_NEON}● proxy local${C_OFF} "
    elif [ -n "$key" ]; then st="${C_LIVE}● con key${C_OFF}     "
    else st="${C_BRASS}○ falta key${C_OFF}   "; fi
    box_row "$C_BORDER_HI" "$(printf '%s%-16s%s %s %-38s %s' "$C_BOLD" "$name" "$C_OFF" "$st" "$(truncate_cols "$url" 38)" "$model")"
  }
  _prof_row default native "suscripción del CLI" "—"
  _prof_row deepseek "${DEEPSEEK_API_KEY:-}" "${DEEPSEEK_BASE_URL:-https://api.deepseek.com/anthropic}" "${DEEPSEEK_MODEL:-deepseek-chat}"
  _prof_row glm "${GLM_API_KEY:-}" "${GLM_BASE_URL:-https://open.bigmodel.cn/api/anthropic}" "${GLM_MODEL:-glm-4.6}"
  _prof_row openrouter "${OPENROUTER_API_KEY:-}" "${OPENROUTER_ANTHROPIC_URL:-https://openrouter.ai/api}" "${OPENROUTER_MODEL:-(--model)}"
  _prof_row local local "${LOCAL_ROUTER_URL:-http://127.0.0.1:3456}" "${LOCAL_ROUTER_MODEL:-default}"
  box_sep "$C_BORDER_HI"
  is_in opencode "${AGENTS[@]}" && box_row "$C_BORDER_HI" "${C_MUTED}opencode usa OpenRouter directo: OPENROUTER_API_KEY $( [ -n "${OPENROUTER_API_KEY:-}" ] && printf '%s● configurada%s' "$C_LIVE" "$C_MUTED" || printf '%s○ falta%s' "$C_BRASS" "$C_MUTED") · modelo por defecto $PRAMA_OPENCODE_MODEL${C_OFF}"
  box_bottom "keys en $PRAMA_CONFIG_HOME/providers.env (chmod 600)" "$C_BORDER_HI"
}

subcmd_mcp() {
  refresh_dimensions
  box_top "☍ SERVIDORES MCP" "" "$C_BORDER_HI"
  local line i dir
  if agent_installed agy; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ agy${C_OFF}"
    while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(timeout 10 agy mcp list 2>&1)
  fi
  if agent_installed claude; then
    box_row "$C_BORDER_HI" "${C_LIVE}▸ claude${C_OFF}"
    while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(timeout 15 claude mcp list 2>&1)
  fi
  for i in "${!ZONES[@]}"; do
    dir=${ZONE_DIRS[$i]}
    [ -f "$dir/.mcp.json" ] || continue
    box_row "$C_BORDER_HI" "${C_LIVE}▸ ${ZONES[$i]}${C_OFF} ${C_MUTED}$dir/.mcp.json${C_OFF}"
    if command -v jq >/dev/null 2>&1; then
      while IFS= read -r line; do box_row "$C_BORDER_HI" "  $line"; done < <(jq -r '.mcpServers // {} | keys[]' "$dir/.mcp.json" 2>&1)
    fi
  done
  box_bottom "" "$C_BORDER_HI"
}

subcmd_doctor() {
  local restore=0
  [ "${1:-}" = "--restore-tmux-conf" ] && restore=1
  refresh_dimensions
  local good="${C_LIVE}✔${C_OFF}" bad="${C_ERR}✖${C_OFF}" meh="${C_BRASS}▲${C_OFF}"
  printf '\n'
  box_top "⚙ DOCTOR" "v$VERSION" "$C_BORDER_HI"

  ensure_tmux_conf 1
  box_row "$C_BORDER_HI" "$good Config tmux de prama regenerada ${C_MUTED}($PRAMA_TMUX_CONF)${C_OFF}"

  local tv
  tv=$(tmux -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
  if awk -v v="${tv:-0}" 'BEGIN{exit !(v >= 3.2)}'; then
    box_row "$C_BORDER_HI" "$good tmux $tv"
  else
    box_row "$C_BORDER_HI" "$meh tmux ${tv:-?}: se recomienda >= 3.2"
  fi

  local dep
  for dep in git fzf jq python3 curl flock less; do
    if command -v "$dep" >/dev/null 2>&1; then
      box_row "$C_BORDER_HI" "$good $dep"
    else
      case "$dep" in
        git) box_row "$C_BORDER_HI" "$bad git no encontrado (necesario para zonas y worktrees)" ;;
        python3|curl) box_row "$C_BORDER_HI" "$meh $dep no encontrado (solo necesario para Telegram)" ;;
        *) box_row "$C_BORDER_HI" "$meh $dep no encontrado (opcional)" ;;
      esac
    fi
  done

  local a
  for a in "${AGENTS[@]}"; do
    if agent_installed "$a"; then
      box_row "$C_BORDER_HI" "$good agente $a ${C_MUTED}$(command -v "$a")${C_OFF}"
    else
      case "$a" in
        opencode) box_row "$C_BORDER_HI" "${C_MUTED}○ agente opencode no instalado (npm i -g @opencode/cli)${C_OFF}" ;;
        *)        box_row "$C_BORDER_HI" "${C_MUTED}○ agente $a no instalado${C_OFF}" ;;
      esac
    fi
  done
  if (( ${#DROPPED_AGENTS[@]} )); then
    box_row "$C_BORDER_HI" "$meh AGENTS en config.env incluye agentes no habilitados (${DROPPED_AGENTS[*]}): se ignoran"
    is_in opencode "${DROPPED_AGENTS[@]}" && box_row "$C_BORDER_HI" "${C_MUTED}  opencode es experimental: PRAMA_EXPERIMENTAL=1 para habilitarlo${C_OFF}"
  fi
  if is_in opencode "${AGENTS[@]}" && [ -z "${OPENROUTER_API_KEY:-}" ]; then
    box_row "$C_BORDER_HI" "$meh opencode sin OPENROUTER_API_KEY en providers.env (o usa 'opencode auth login')"
  fi
  if watchdog_running; then box_row "$C_BORDER_HI" "$good watchdog de la flota activo"
  else box_row "$C_BORDER_HI" "${C_MUTED}○ watchdog detenido (arranca con el primer agente)${C_OFF}"; fi
  if agent_installed agy && (( ${PRAMA_HOOKS:-1} )); then
    if agy_hooks_installed; then box_row "$C_BORDER_HI" "$good hooks de agy instalados (~/.gemini/config/hooks.json)"
    else box_row "$C_BORDER_HI" "${C_MUTED}○ hooks de agy: se instalan al lanzar agy (prama-agent fleet hooks)${C_OFF}"; fi
  fi
  command -v jq >/dev/null 2>&1 || box_row "$C_BORDER_HI" "$meh jq no instalado: sin telemetría de cuota ni hooks de agy (sudo apt install jq)"

  box_row "$C_BORDER_HI" "$good Estado privado (0700) ${C_MUTED}$PRAMA_STATE_HOME${C_OFF}"
  state_gc

  if (( PRAMA_SKIP_PERMISSIONS )); then
    if (( EUID == 0 )); then
      box_row "$C_BORDER_HI" "$meh YOLO por defecto ejecutando como root: usa un usuario sin privilegios o PRAMA_SKIP_PERMISSIONS=0"
    else
      box_row "$C_BORDER_HI" "$meh YOLO por defecto activado (PRAMA_SKIP_PERMISSIONS=1)"
    fi
  fi

  # Detach clients idle for more than 6h (zombie SSH sessions that pin the window size)
  local c_tty c_sess c_act now detached=0
  now=$(date +%s)
  while IFS='|' read -r c_tty c_sess c_act; do
    [ -z "$c_tty" ] && continue
    if (( now - ${c_act:-$now} > 21600 )); then
      tmx detach-client -t "$c_tty" 2>/dev/null && (( detached++ ))
    fi
  done < <(tmx list-clients -F '#{client_name}|#{client_session}|#{client_activity}' 2>/dev/null)
  box_row "$C_BORDER_HI" "$good Clientes inactivos desconectados: $detached"

  local i
  for i in "${!ZONES[@]}"; do
    git -C "${ZONE_DIRS[$i]}" worktree prune 2>/dev/null || true
  done
  box_row "$C_BORDER_HI" "$good Metadatos de worktrees saneados"

  # ── Migration from v5 ──
  if [ -d /tmp/prama-bus ] && [ "$(stat -c %u /tmp/prama-bus 2>/dev/null)" = "$EUID" ]; then
    rm -rf /tmp/prama-bus && box_row "$C_BORDER_HI" "$good Eliminado el bus inseguro de v5 (/tmp/prama-bus)"
  elif [ -d /tmp/prama-bus ]; then
    box_row "$C_BORDER_HI" "$meh /tmp/prama-bus existe y pertenece a otro usuario: revísalo (posible ataque)"
  fi
  if grep -q 'prama-agent-managed' "$HOME/.tmux.conf" 2>/dev/null; then
    if (( restore )); then
      mv -f "$HOME/.tmux.conf" "$HOME/.tmux.conf.prama-v5"
      if [ -f "$HOME/.tmux.conf.bak" ] && ! grep -q 'prama-agent-managed' "$HOME/.tmux.conf.bak"; then
        cp -p "$HOME/.tmux.conf.bak" "$HOME/.tmux.conf"
        box_row "$C_BORDER_HI" "$good ~/.tmux.conf original restaurado desde .bak"
      else
        box_row "$C_BORDER_HI" "$good ~/.tmux.conf de v5 retirado (guardado en ~/.tmux.conf.prama-v5)"
      fi
    else
      box_row "$C_BORDER_HI" "$meh ~/.tmux.conf fue sobrescrito por prama v5. Ejecuta: prama-agent doctor --restore-tmux-conf"
    fi
  fi
  if tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -q "^${PRAMA_SESSION_PREFIX}-"; then
    box_row "$C_BORDER_HI" "$meh Hay sesiones '${PRAMA_SESSION_PREFIX}-*' de v5 en tu tmux personal; v6 usa su propio servidor (tmux -L $PRAMA_TMUX_SOCKET)."
  fi

  local unmanaged
  unmanaged=$(find_unmanaged_agents)
  if [ -n "$unmanaged" ]; then
    box_row "$C_BORDER_HI" "$meh $(wc -l <<< "$unmanaged") agente(s) corriendo fuera de prama (ver 'prama-agent status')"
  fi
  box_bottom "listo" "$C_BORDER_HI"
  printf '\n'
}

subcmd_completion() {
  [ "${1:-bash}" = "bash" ] || die "Solo bash está soportado por ahora."
  cat <<'EOF'
# prama-agent bash completion — add to ~/.bashrc:  eval "$(prama-agent completion bash)"
_prama_agent() {
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]} first=${COMP_WORDS[1]:-}
  local subs="status ls sessions attach logs capture send restart stop fleet bus cockpit fzf worktree profiles mcp zones agents telegram doctor completion info help"
  case "$prev" in
    --role|-O) COMPREPLY=($(compgen -W "executor coordinator reader daemon" -- "$cur")); return ;;
    --profile|-P) COMPREPLY=($(compgen -W "default openrouter deepseek glm local" -- "$cur")); return ;;
    --model|-m) COMPREPLY=($(compgen -W "opus sonnet haiku fable openrouter/qwen/qwen3-coder:free openrouter/moonshotai/kimi-k2 openrouter/z-ai/glm-4.6 openrouter/deepseek/deepseek-chat" -- "$cur")); return ;;
    --effort) COMPREPLY=($(compgen -W "low medium high xhigh max" -- "$cur")); return ;;
  esac
  case "$first" in
    attach|a|logs|capture|send|restart|stop)
      [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(prama-agent sessions 2>/dev/null)" -- "$cur")); return ;;
    bus) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "status assign report inbox broadcast watch swarm-start clear help" -- "$cur")); return ;;
    fleet)
      if [ "$COMP_CWORD" -eq 2 ]; then COMPREPLY=($(compgen -W "status spawn model edit restart kill presets models watchdog hooks help" -- "$cur"))
      elif [ "$COMP_CWORD" -eq 3 ]; then
        case "${COMP_WORDS[2]}" in
          model|edit|restart|kill) COMPREPLY=($(compgen -W "$(prama-agent sessions 2>/dev/null)" -- "$cur")) ;;
          spawn) COMPREPLY=($(compgen -W "${AGENTS[*]}" -- "$cur")) ;;
        esac
      fi; return ;;
    telegram) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "setup start stop restart status logs test notify" -- "$cur")); return ;;
    worktree) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "list create remove prune" -- "$cur")); return ;;
  esac
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "$subs $(prama-agent agents 2>/dev/null | awk '{print $1}')" -- "$cur"))
  elif [[ "$cur" == -* ]]; then
    COMPREPLY=($(compgen -W "--role --ask --plan --yolo --remote --no-remote --model --effort --preset --profile --worktree --name --bg --porcelain --parallel --loop --task --oneshot --direct --dry-run" -- "$cur"))
  else
    COMPREPLY=($(compgen -W "$(prama-agent zones 2>/dev/null | awk '{print $1}')" -- "$cur"))
  fi
}
complete -F _prama_agent prama-agent
EOF
}

# ── Internal runner (executed inside the tmux pane) ─────────────────────────
if [ "${1:-}" = "--internal-watchdog" ]; then
  watchdog_loop
  exit 0
fi
if [ "${1:-}" = "--internal-runner" ]; then
  shift
  internal_runner "$@"
  exit $?
fi

# ── Subcommand dispatch ─────────────────────────────────────────────────────
if [ $# -gt 0 ]; then
  case $1 in
    status|ls|ps)          subcmd_status; exit 0 ;;
    sessions)              shift; subcmd_sessions "$@"; exit 0 ;;
    zones)                 shift; subcmd_zones "$@"; exit 0 ;;
    agents)                shift; subcmd_agents "$@"; exit 0 ;;
    cockpit|ui)            shift; subcmd_cockpit "$@"; exit $? ;;
    fzf|find)              launch_fzf_cockpit; exit $? ;;
    bus|swarm)             shift; subcmd_bus "$@"; exit $? ;;
    fleet)                 shift; subcmd_fleet "$@"; exit $? ;;
    telegram|tg|bot)       shift; subcmd_telegram "$@"; exit $? ;;
    attach|a)              shift; subcmd_attach "${1:-}"; exit $? ;;
    stop|kill|k)           shift; subcmd_stop "$@"; exit $? ;;
    restart|r)             shift; subcmd_restart "${1:-}"; exit $? ;;
    logs|peek|log)         shift; subcmd_logs "${1:-}" "${2:-80}"; exit $? ;;
    capture)               shift; subcmd_capture "${1:-}" "${2:-40}"; exit $? ;;
    send|inject)           shift; subcmd_send "$@"; exit $? ;;
    worktree|worktrees|wt) shift; subcmd_worktree "$@"; exit $? ;;
    profiles|providers)    subcmd_profiles; exit 0 ;;
    mcp)                   subcmd_mcp; exit 0 ;;
    doctor|fix)            shift; subcmd_doctor "$@"; exit 0 ;;
    completion)            shift; subcmd_completion "$@"; exit 0 ;;
    info|--info)           subcmd_info; exit 0 ;;
    -h|--help|help)        usage; exit 0 ;;
  esac
fi

# ── Launch arguments ────────────────────────────────────────────────────────
AGENT='' ZONE='' DRY=0 BG=0 DIRECT=0 ONESHOT=0 PARALLEL=0 PORCELAIN=0
REMOTE="$PRAMA_DEFAULT_REMOTE"
ROLE="$PRAMA_DEFAULT_ROLE"
PERM_MODE="ask"
(( PRAMA_SKIP_PERMISSIONS )) && PERM_MODE="yolo"
PERM_EXPLICIT=0 AGENT_EXPLICIT=0 ROLE_EXPLICIT=0 PROFILE_EXPLICIT=0
DAEMON_INTERVAL=60 DAEMON_TASK='' WORKTREE='' CUSTOM_NAME='' PROFILE='default'
PASS=()

need_arg() { [ "$1" -ge 2 ] || die "$2"; }

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run)          DRY=1; shift ;;
    --bg|-d|--detach)   BG=1; shift ;;
    --porcelain)        PORCELAIN=1; BG=1; shift ;;
    --direct|--no-tmux) DIRECT=1; shift ;;
    --oneshot)          ONESHOT=1; shift ;;
    --parallel)         PARALLEL=1; shift ;;
    --remote|-R)        REMOTE=1; shift ;;
    --no-remote)        REMOTE=0; shift ;;
    --safe|--ask)       PERM_MODE="ask"; PERM_EXPLICIT=1; shift ;;
    --yolo)             PERM_MODE="yolo"; PERM_EXPLICIT=1; shift ;;
    --plan|--readonly)  PERM_MODE="plan"; PERM_EXPLICIT=1; shift ;;
    --perm)
      need_arg $# "--perm requiere: ${AVAILABLE_PERM_MODES[*]}"
      is_in "$2" "${AVAILABLE_PERM_MODES[@]}" || die "--perm debe ser: ${AVAILABLE_PERM_MODES[*]}"
      PERM_MODE=$2; PERM_EXPLICIT=1; shift 2 ;;
    --role|-O)
      need_arg $# "--role requiere: ${AVAILABLE_ROLES[*]}"
      is_in "$2" "${AVAILABLE_ROLES[@]}" || die "--role debe ser: ${AVAILABLE_ROLES[*]}"
      ROLE=$2; ROLE_EXPLICIT=1; shift 2 ;;
    --model|-m)
      need_arg $# "--model requiere un modelo"
      valid_model "$2" || die "Modelo inválido: '$2'"
      AGENT_MODEL=$2; shift 2 ;;
    --effort)
      need_arg $# "--effort requiere: low medium high xhigh max"
      [[ "$2" =~ ^(low|medium|high|xhigh|max)$ ]] || die "--effort debe ser: low medium high xhigh max"
      AGENT_EFFORT=$2; shift 2 ;;
    --preset)
      need_arg $# "--preset requiere un nombre (prama-agent fleet presets)"
      preset_find "$2" >/dev/null || die "Preset desconocido '$2'. Disponibles: $(preset_names | tr '\n' ' ')"
      PRESET=$2; shift 2 ;;
    --loop)
      need_arg $# "--loop requiere segundos"
      [[ "$2" =~ ^[0-9]+$ ]] && (( $2 >= 5 )) || die "--loop requiere un número de segundos >= 5"
      DAEMON_INTERVAL=$2; ROLE="daemon"; shift 2 ;;
    --task)
      need_arg $# "--task requiere una instrucción"
      DAEMON_TASK=$2; shift 2 ;;
    --name|-n)
      need_arg $# "--name requiere un nombre de sesión"
      valid_session_name "$2" || die "Nombre inválido '$2': usa letras, números, - y _ (máx. 48)."
      CUSTOM_NAME=$2; shift 2 ;;
    --worktree|-w)
      need_arg $# "--worktree requiere un nombre de rama"
      WORKTREE=$2; shift 2 ;;
    --profile|-P)
      need_arg $# "--profile requiere un perfil"
      is_in "$2" "${AVAILABLE_PROFILES[@]}" || die "Perfil desconocido '$2'. Opciones: ${AVAILABLE_PROFILES[*]}"
      PROFILE=$2; PROFILE_EXPLICIT=1; shift 2 ;;
    --zone|-z)
      need_arg $# "--zone requiere una zona"
      ZONE=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; PASS+=("$@"); break ;;
    *)
      if [ -z "$AGENT" ] && _m=$(match_one "$1" "${AGENTS[@]}"); then AGENT=$_m; AGENT_EXPLICIT=1
      elif [ -z "$ZONE" ] && _m=$(match_one "$1" "${ZONES[@]}"); then ZONE=$_m
      elif is_in "$1" "${AVAILABLE_ROLES[@]}"; then ROLE=$1; ROLE_EXPLICIT=1
      else PASS+=("$1"); fi
      shift ;;
  esac
done

# A preset may pick the agent, role and endpoint profile (explicit flags win).
preset_apply_defaults "$AGENT_EXPLICIT" "$ROLE_EXPLICIT" "$PROFILE_EXPLICIT" || exit 1

if [ "$ROLE" = "reader" ]; then
  [ "$PERM_EXPLICIT" = 1 ] && [ "$PERM_MODE" != "plan" ] && warn "El rol reader fuerza el modo plan (solo lectura)."
  PERM_MODE="plan"
fi

# ── Interactive TUI ─────────────────────────────────────────────────────────
if [ -z "$AGENT" ] || [ -z "$ZONE" ]; then
  if (( ! ${IS_TERM:-$IS_TTY} )) || [ ! -t 0 ]; then
    [ -n "$AGENT" ] && die "Falta la zona. Zonas disponibles: ${ZONES[*]}"
    usage
    exit 1
  fi
  ensure_tmux_conf
  tui_main
  exit $?
fi

# ── Direct CLI launch ───────────────────────────────────────────────────────
if (( DRY || DIRECT )); then
  DIR=$(zone_dir "$ZONE") || die "La zona '$ZONE' no está registrada."
  [ -d "$DIR" ] || die "El directorio '$DIR' de la zona '$ZONE' no existe."
  agent_installed "$AGENT" || die "El agente '$AGENT' no está instalado."
  SESSION_NAME=${CUSTOM_NAME:-$(session_name_for "$AGENT" "$ZONE" "$ROLE" "$WORKTREE")}
  TARGET_DIR=$DIR
  if [ -n "$WORKTREE" ]; then
    if (( DRY )); then TARGET_DIR=$(worktree_path "$DIR" "$WORKTREE")
    else TARGET_DIR=$(provision_worktree "$DIR" "$WORKTREE") || exit 1; fi
  fi
  ROLE_PROMPT=""
  [ "$ROLE" != "executor" ] && ROLE_PROMPT=$(build_role_system_prompt "$ROLE" "$SESSION_NAME" "$ZONE")
  PROFILE=$PROFILE build_agent_command "$AGENT" "$PERM_MODE" "$REMOTE" "$SESSION_NAME" "$ROLE_PROMPT" ${PASS[@]+"${PASS[@]}"}
  if (( DRY )); then
    printf -v ESCAPED '%q ' "${CMD[@]}"
    printf 'cd %q && ROLE=%q PERM=%q REMOTE=%q PROFILE=%q tmux -L %q new-session -s %q -- %s\n' \
      "$TARGET_DIR" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$PRAMA_TMUX_SOCKET" "$SESSION_NAME" "${ESCAPED% }"
    exit 0
  fi
  apply_provider_profile "$PROFILE"
  agent_runtime_env "$AGENT" "$SESSION_NAME" "$PERM_MODE" "$ROLE_PROMPT"
  cd "$TARGET_DIR" || die "No se pudo entrar a $TARGET_DIR"
  if [ "$PERM_MODE" = "yolo" ]; then export IS_SANDBOX=1; else unset IS_SANDBOX; fi
  export PRAMA_SESSION="$SESSION_NAME" PRAMA_ROLE="$ROLE"
  exec "${CMD[@]}"
fi

MODE="attach"
(( BG )) && MODE="bg"
(( PORCELAIN )) && MODE="porcelain"
launch_agent "$AGENT" "$ZONE" "$ROLE" "$PERM_MODE" "$REMOTE" "$PROFILE" "$WORKTREE" "$MODE" "$CUSTOM_NAME"
